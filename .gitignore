/build/

# Game files are never part of the repository.
/assets/*
!/assets/README.md
# DXVK writes <exe>_d3d9.log into the working folder.
*.log
# Official DXVK binaries/headers are fetched at build time, not committed.
/dxvk/prebuilt/linux/
/dxvk/prebuilt/windows/
# Playtest diagnostics (--diag DIR) kept in the port folder.
/diag*/
tools/data/default_xbe_matchdata.tsv

# Local naming notes (not published)
tools/data/cod4_reference.csv
tools/data/*.csv.lock
__pycache__/
tools/data/functions_twice.csv
