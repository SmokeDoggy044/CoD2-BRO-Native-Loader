msgstr "~menu_back Voltar"

# ---- prologue.en.stb ----
msgctxt "0x988f0f25"
msgid "02.73|04.10|You're gonna be alright, |Sarge, alright?"
msgstr "02.73|04.10|Você vai ficar bem, |Sargento, tá bom?"

msgctxt "0x988f0f26"
msgid "04.23|05.10|You stay with me, okay?"
msgstr "04.23|05.10|Fica comigo, tá?"

msgctxt "0x6d69ec6b"
msgid "04.47|07.47|Man, I can't wait to put this baby to some real use!"
msgstr "04.47|07.47|Cara, mal posso esperar pra usar essa belezinha de verdade!"

msgctxt "0x988f0f27"
msgid "05.10|06.84|Where's that damn medic?!"
msgstr "05.10|06.84|Cadê a porcaria do médico?!"

msgctxt "0x988f0f20"
msgid "06.84|07.84|You just look at me!"
msgstr "06.84|07.84|Olha pra mim!"

msgctxt "0x6d69ec68"
msgid "07.44|09.84|Get a load of him! Where do they keep gettin' these guys?"
msgstr "07.44|09.84|Olha só pra ele! De onde eles tão tirando esses caras?"

msgctxt "0x988f0f21"
msgid "07.84|11.01|You're gonna be alright, |Sarge, you're gonna be okay!"
msgstr "07.84|11.01|Você vai ficar bem, |Sargento, vai ficar tudo bem!"

msgctxt "0xf6169f71"
msgid "0840 Hours"
msgstr "08h40"

msgctxt "0x6d69ec69"
msgid "09.77|10.84|Give it a rest, Brooklyn."
msgstr "09.77|10.84|Dá um tempo, Brooklyn."

msgctxt "0x6d69ec6e"
msgid "10.74|12.71|Yeah, fine. You collect his dog tags."
msgstr "10.74|12.71|Tá, beleza. Então você recolhe as plaquetas dele."

msgctxt "0x6d69ec6f"
msgid "12.67|14.54|What's he sore about? I just said -"
msgstr "12.67|14.54|Qual é a dele? Eu só disse -"

msgctxt "0x6d69ec6c"
msgid "14.54|18.28|Hey look, replacement, just 'cause you got that patch|on your shoulder don't mean you're one of us."
msgstr "14.54|18.28|Olha aqui, novato, só porque você tem esse emblema|no ombro não quer dizer que é um de nós."

msgctxt "0x6d69ec6d"
msgid "18.78|20.62|What'd you say your name was?"
msgstr "18.78|20.62|Como é que você disse que se chama?"

msgctxt "0x6d69ec62"
msgid "20.62|22.15|Andy... Andy Allen!"
msgstr "20.62|22.15|Andy... Andy Allen!"

msgctxt "0x6d69ec63"
msgid "22.12|26.52|Don't mind him, Allen.|He lost a lot of friends in France. We all did."
msgstr "22.12|26.52|Não liga pra ele, Allen.|Ele perdeu muitos amigos na França. Todos nós perdemos."

msgctxt "0xad3d8d5d"
msgid "26.72|32.26|It's hell out there guys. It looks like a whole division of SS|has moved in and they aren't giving up those crossroads."
msgstr "26.72|32.26|Tá um inferno lá fora, pessoal. Parece que uma divisão inteira da SS|chegou e eles não vão largar aquele cruzamento."

msgctxt "0xad3d8d5c"
msgid "32.23|36.88|Okay, listen up. We got a regiment of mechanized SS|dug in across that river."
msgstr "32.23|36.88|Certo, prestem atenção. Tem um regimento mecanizado da SS|entrincheirado do outro lado do rio."

msgctxt "0xad3d8d5f"
msgid "36.87|42.07|Division wants control of those crossroads so it's Fox's job|to clear that bridge for our armor."
msgstr "36.87|42.07|A Divisão quer o controle daquele cruzamento, então é trabalho da Fox|liberar aquela ponte pros nossos blindados."

msgctxt "0xad3d8d5e"
msgid "42.44|45.84|Can't we get some air support, sir?|It'd sure make this a hell of a lot easier."
msgstr "42.44|45.84|Não dá pra ter apoio aéreo, senhor?|Ia facilitar muito as coisas."

msgctxt "0xad3d8d59"
msgid "45.91|47.61|Look out! Stukas!"
msgstr "45.91|47.61|Cuidado! Stukas!"

msgctxt "0xad3d8d58"
msgid "48.71|53.92|There's no time. We gotta take that damn bridgehead right now."
msgstr "48.71|53.92|Não dá tempo. Temos que tomar aquela maldita cabeça de ponte agora."

msgctxt "0x97b1f839"
msgid "4|Maybe if we move through those buildings, we could get|a bead on that 20mm, sarge."
msgstr "4|Talvez se a gente passar por esses prédios, dê pra|mirar naquele 20 mm, Sargento."

msgctxt "0x07d040a8"
msgid "4|Maybe we can draw its fire so our guys can take it out|with satchel charges."
msgstr "4|Talvez a gente consiga atrair o fogo dele pros nossos caras|acabarem com ele com cargas explosivas."

msgctxt "0xad3d8d5b"
msgid "54.12|57.35|Sergeant, I want you to take your squad and move down that hill."
msgstr "54.12|57.35|Sargento, quero que você leve seu esquadrão morro abaixo."

msgctxt "0xad3d8d5a"
msgid "58.69|60.22|Incoming!"
msgstr "58.69|60.22|Lá vem!"

msgctxt "0xe6194e7d"
msgid "Across the river!"
msgstr "Do outro lado do rio!"

msgctxt "0x9515d7f4"
msgid "Advance down the Hill"
msgstr "Desça o morro"

msgctxt "0x9515d7f1"
msgid "Advance to Flanking Position"
msgstr "Avance até a posição de flanco"

msgctxt "0x9515d7f2"
msgid "Advance towards the Eastern Bridge"
msgstr "Avance em direção à Ponte Leste"

msgctxt "0xccb44818"
msgid "Allen and I will go first."
msgstr "Eu e o Allen vamos primeiro."

msgctxt "0xd871e80c"
msgid "Allen! Medic!"
msgstr "Allen! Médico!"

msgctxt "0x6a0b3581"
msgid "Allen, get down! Get down!"
msgstr "Allen, abaixa! Abaixa!"

msgctxt "0x9515d7fc"
msgid "Assault Eastern Bridge"
msgstr "Ataque a Ponte Leste"

msgctxt "0x9515d7f0"
msgid "Assault Western Bridge"
msgstr "Ataque a Ponte Oeste"

msgctxt "0x39ba9a87"
msgid "Aw, Christ! Fall back!"
msgstr "Ah, droga! Recuar!"

msgctxt "0x3d3b4de7"
msgid "C'mon Sarge, let's go!"
msgstr "Vamos, Sargento, vamos nessa!"

msgctxt "0xa2bafea1"
msgid "Clear out German Resistance"
msgstr "Elimine a resistência alemã"

msgctxt "0x8e0092cb"
msgid "Come on... plant that charge... come on..."
msgstr "Vai... planta essa carga... vai..."

msgctxt "0xa2bafea7"
msgid "Defend this Area"
msgstr "Defenda esta área"

msgctxt "0xa2bafea0"
msgid "Eliminate the Flak Gun"
msgstr "Elimine o canhão antiaéreo"

msgctxt "0xa2bafea3"
msgid "Find route across the Bridge"
msgstr "Encontre um caminho pela ponte"

msgctxt "0xf669be77"
msgid "Get outta there!"
msgstr "Sai daí!"

msgctxt "0x9515d7fd"
msgid "Get past Panzer Tank Machine Gun"
msgstr "Passe pela metralhadora do Panzer"

msgctxt "0x9515d7f6"
msgid "Get to Defensive Position"
msgstr "Vá até a posição defensiva"

msgctxt "0x05d87e86"
msgid "Good, now we can-- watch out!"
msgstr "Boa, agora a gente pode... cuidado!"

msgctxt "0x7c732ca4"
msgid "Here they come!"
msgstr "Lá vêm eles!"

msgctxt "0xa2bafea6"
msgid "Hold this Position"
msgstr "Segure esta posição"

msgctxt "0x2a2657b9"
msgid "Hold up! Hold up!"
msgstr "Espera! Espera!"

msgctxt "0x6619b4b0"
msgid "I guess we're up, Sarge. Here we go..."
msgstr "Acho que é a nossa vez, Sargento. Lá vamos nós..."

msgctxt "0x9a88de68"
msgid "In the buildings!"
msgstr "Nos prédios!"

msgctxt "0xcd548d58"
msgid "Incoming!"
msgstr "Fogo chegando!"

msgctxt "0x0dd5a55e"
msgid "Keep lookin' at me Sarge, stay with me..."
msgstr "Continua olhando pra mim, Sargento, fica comigo..."

msgctxt "0xc7a3993f"
msgid "Lay some smoke so our planes don't get us instead!"
msgstr "Joga fumaça pros nossos aviões não acertarem a gente!"

msgctxt "0xc7a3813f"
msgid "Lay some smoke so we don't get hammered by our own bombs!"
msgstr "Joga fumaça pra gente não levar bomba dos nossos!"

msgctxt "0xca2b7a94"
msgid "Look out, here they come!"
msgstr "Cuidado, lá vêm eles!"

msgctxt "0xc7c5446d"
msgid "Look, a Sherman!"
msgstr "Olha, um Sherman!"

msgctxt "0xc2915e9b"
msgid "Maubeuge, France"
msgstr "Maubeuge, França"

msgctxt "0xcba2426e"
msgid "Move up! Clear out those buildings!"
msgstr "Avancem! Limpem esses prédios!"

msgctxt "0x7a251622"
msgid "Nice shot, Sarge!"
msgstr "Belo tiro, Sargento!"

msgctxt "0xcad267d1"
msgid "Now!"
msgstr "Agora!"

msgctxt "0xf7d85a88"
msgid "Now's your chance to use that rifle, Allen."
msgstr "Agora é sua chance de usar esse fuzil, Allen."

msgctxt "0xa2bafea2"
msgid "Plant Charge on the Tiger Tank"
msgstr "Plante a carga no tanque Tiger"

msgctxt "0x9a9a8516"
msgid "Press and hold [SPRINT] Button to sprint"
msgstr "Pressione e segure [SPRINT] para correr"

msgctxt "0x9515d7f7"
msgid "Regroup in Basement"
msgstr "Reagrupe no porão"

msgctxt "0x9515d7f3"
msgid "Regroup with Squad"
msgstr "Reagrupe com o esquadrão"

msgctxt "0x6e501091"
msgid "Sarge! Wait!"
msgstr "Sargento! Espera!"

msgctxt "0x3014b4c2"
msgid "Sarge, come back!"
msgstr "Sargento, volta!"

msgctxt "0x04b4b583"
msgid "Sarge, come back!"
msgstr "Sargento, volta!"

msgctxt "0xd7e799a4"
msgid "Sarge, look! I bet we could get that bastard with a satchel charge now!"
msgstr "Sargento, olha! Aposto que dá pra pegar esse desgraçado com uma carga de demolição agora!"

msgctxt "0x04b2d0d4"
msgid "Sarge, over here!"
msgstr "Sargento, aqui!"

msgctxt "0x3012d115"
msgid "Sarge, over here!"
msgstr "Sargento, aqui!"

msgctxt "0x04bf2995"
msgid "Sarge, this way!"
msgstr "Sargento, por aqui!"

msgctxt "0x301f28d4"
msgid "Sarge, this way!"
msgstr "Sargento, por aqui!"

msgctxt "0xf61ebc51"
msgid "September 7th, 1944"
msgstr "7 de setembro de 1944"

msgctxt "0xc45ab96c"
msgid "Stay down, Allen!"
msgstr "Fica abaixado, Allen!"

msgctxt "0x619ac860"
msgid "Stuka!"
msgstr "Stuka!"

msgctxt "0x4f9ba767"
msgid "Stukas! Watch out!"
msgstr "Stukas! Cuidado!"

msgctxt "0x2afed611"
msgid "Take cover!"
msgstr "Protejam-se!"

msgctxt "0x525ada57"
msgid "Take cover! Take--"
msgstr "Protejam-se! Prote..."

msgctxt "0xb9b2d9dd"
msgid "The bridge is clear!"
msgstr "A ponte está livre!"

msgctxt "0xb47e2c5a"
msgid "There's our Sherman!"
msgstr "Lá está o nosso Sherman!"

msgctxt "0x1f9be5c0"
msgid "There's the bridge, Sarge!"
msgstr "Lá está a ponte, Sargento!"

msgctxt "0x4a085bc6"
msgid "They got our armor, damn!"
msgstr "Pegaram nossos blindados, droga!"

msgctxt "0x4a0853c6"
msgid "They got our tank!"
msgstr "Pegaram nosso tanque!"

msgctxt "0x9e8b9f6b"
msgid "They're coming across!"
msgstr "Eles estão atravessando!"

msgctxt "0x4795d37f"
msgid "Those Shermans should clear the way for us."
msgstr "Esses Shermans devem abrir caminho pra gente."

msgctxt "0xef062cce"
msgid "Through that basement!"
msgstr "Pelo porão!"

msgctxt "0xef0624ce"
msgid "Through that basement, follow me!"
msgstr "Pelo porão, me sigam!"

msgctxt "0x79301596"
msgid "Tiger! Across the bridge!"
msgstr "Tiger! Do outro lado da ponte!"

msgctxt "0x4943f0ca"
msgid "Up and over!"
msgstr "Sobe e passa!"

msgctxt "0x0dd8dd14"
msgid "Wait for the bastard to reload, then move."
msgstr "Espera o desgraçado recarregar, aí avança."

msgctxt "0x1c8f47e4"
msgid "Wait for the reload... and..."
msgstr "Espera ele recarregar... e..."

msgctxt "0x5c3bd5ef"
msgid "Watch it! That turret is still active!"
msgstr "Cuidado! Essa torre ainda está ativa!"

msgctxt "0xf0458cc5"
msgid "We got some bombers comin' in to flatten this friggin' berg!"
msgstr "Vêm uns bombardeiros aí pra arrasar essa droga de vilarejo!"

msgctxt "0xc3cb08bf"
msgid "We've Been Through Worse"
msgstr "Já Passamos por Coisa Pior"

msgctxt "0x17f8567a"
msgid "Well, I'm sure as hell not stayin' here."
msgstr "Bom, eu é que não vou ficar aqui."

msgctxt "0x9e1bad44"
msgid "Where's that damn medic?!"
msgstr "Cadê a droga do médico?!"

msgctxt "0x2c33a667"
msgid "You never need to try to open closed doors"
msgstr "Você nunca precisa tentar abrir portas fechadas"

msgctxt "0x9f57cb31"
msgid "You're gonna be okay, Sarge. Stay with me..."
msgstr "Você vai ficar bem, Sargento. Fica comigo..."

msgctxt "0x153b48d1"
msgid "[PRESS_ACTIVATE] to mount a turret"
msgstr "[PRESS_ACTIVATE] para usar uma metralhadora fixa"

msgctxt "0xe713c870"
msgid "[PRESS_ACTIVATE] to pickup a dropped weapon"
msgstr "[PRESS_ACTIVATE] para pegar uma arma caída"

msgctxt "0x858be2b1"
msgid "[PRESS_ACTIVATE] to plant the charge"
msgstr "[PRESS_ACTIVATE] para plantar a carga"

msgctxt "0x3ae82a7f"
msgid "[PRESS_ATTACK] to attack"
msgstr "[PRESS_ATTACK] para atacar"

msgctxt "0x28ac42ae"
msgid "[PRESS_ATTACK] to fire"
msgstr "[PRESS_ATTACK] para atirar"

msgctxt "0x56231cb3"
msgid "[PRESS_GRENADE] to throw grenades"
msgstr "[PRESS_GRENADE] para lançar granadas"

msgctxt "0x28aa315b"
msgid "[PRESS_JUMP] to jump"
msgstr "[PRESS_JUMP] para pular"

msgctxt "0x4b5f6fb8"
msgid "[PRESS_SELECT] to bring up the Objectives Screen"
msgstr "[PRESS_SELECT] para abrir a tela de objetivos"

msgctxt "0xbab474aa"
msgid "[PRESS_STANCE_DOWN] to crouch, press it again to go prone"
msgstr "[PRESS_STANCE_DOWN] para agachar; pressione de novo para deitar"

msgctxt "0x14d698c1"
msgid "[PRESS_STANCE_UP] to stand up"
msgstr "[PRESS_STANCE_UP] para ficar de pé"

msgctxt "0x4f3c2f2f"
msgid "[USE_LEFT_STICK] to move around"
msgstr "[USE_LEFT_STICK] para se mover"

msgctxt "0xcf3c0fe4"
msgid "[USE_RIGHT_STICK] to look around"
msgstr "[USE_RIGHT_STICK] para olhar ao redor"

# ---- oran.en.stb ----
msgctxt "0x381a18b8"
msgid " "
msgstr " "

msgctxt "0xe97b4380"
msgid "03.73|05.20|Man, I'm starvin'!"
msgstr "03.73|05.20|Cara, tô morrendo de fome!"

msgctxt "0xe97b5b80"
msgid "04.00|04.93|He was there."
msgstr "04.00|04.93|Ele estava lá."

msgctxt "0xe97b5b83"
msgid "05.20|06.73|You shoulda seen me, it was incredible."
msgstr "05.20|06.73|Tinha que ter me visto, foi incrível."

msgctxt "0xe97b4383"
msgid "05.20|06.77|Haven't eaten nothin' since we left the ship."
msgstr "05.20|06.77|Não comi nada desde que saímos do navio."

msgctxt "0xe97b5b82"
msgid "06.90|09.04|Caught these two French bastards by surprise..."
msgstr "06.90|09.04|Peguei esses dois franceses desgraçados de surpresa..."

msgctxt "0x7dbaff5b"
msgid "0630 Hours"
msgstr "06h30"

msgctxt "0xe97b4382"
msgid "07.10|09.07|Hey, you know, my dad runs a deli back in the Bronx."
msgstr "07.10|09.07|Sabe, meu pai tem uma delicatéssen lá no Bronx."

msgctxt "0xe97b5b85"
msgid "09.04|11.27|Took 'em both out, single handed."
msgstr "09.04|11.27|Derrubei os dois, sozinho."

msgctxt "0xe97b4385"
msgid "09.20|11.41|Makes the best pastrami sandwiches you'll ever eat."
msgstr "09.20|11.41|Faz o melhor sanduíche de pastrami que você já comeu."

msgctxt "0xe97b5b84"
msgid "11.27|11.77|Tell 'em, would ya?"
msgstr "11.27|11.77|Conta pra eles, vai?"

msgctxt "0xe97b4384"
msgid "11.41|13.21|Brooklyn, you ain't quite right."
msgstr "11.41|13.21|Brooklyn, você não bate bem."

msgctxt "0xe97b5b87"
msgid "11.77|13.01|You're full of it, Brooklyn."
msgstr "11.77|13.01|Você é um mentiroso, Brooklyn."

msgctxt "0xc35b6276"
msgid "12 o'clock!"
msgstr "Às 12 horas!"

msgctxt "0xce49026a"
msgid "12 o'clock!"
msgstr "Às 12 horas!"

msgctxt "0xe97b5b86"
msgid "13.01|14.17|Hey, how many times I gotta tell ya?"
msgstr "13.01|14.17|Ei, quantas vezes eu tenho que te dizer?"

msgctxt "0xe97b4387"
msgid "14.11|16.01|Kinda like your sister, huh? Ya friggin' hayseed..."
msgstr "14.11|16.01|Que nem a sua irmã, né? Seu caipira..."

msgctxt "0xe97b5b89"
msgid "14.17|14.64|I'm from the Bronx!"
msgstr "14.17|14.64|Eu sou do Bronx!"

msgctxt "0xe97b5b88"
msgid "14.64|16.04|Just be glad you're not dead."
msgstr "14.64|16.04|Agradeça por não estar morto."

msgctxt "0x2f6b702d"
msgid "16.44|18.38|Good work, but this was just the scrub team."
msgstr "16.44|18.38|Bom trabalho, mas esse era só o time reserva."

msgctxt "0xe97b4386"
msgid "16.71|19.52|Can it, you two. Stay on the ball."
msgstr "16.71|19.52|Chega, vocês dois. Fiquem atentos."

msgctxt "0x2f6b702c"
msgid "18.38|20.71|Rommel and his boys are gonna be a helluva lot tougher."
msgstr "18.38|20.71|Rommel e os rapazes dele vão ser bem mais duros."

msgctxt "0xe97b4389"
msgid "19.52|21.48|This ain't boot camp."
msgstr "19.52|21.48|Isso aqui não é o treinamento."

msgctxt "0x692355a1"
msgid "2 Years Earlier"
msgstr "2 Anos Antes"

msgctxt "0x2f6b702f"
msgid "20.85|22.08|Trust me."
msgstr "20.85|22.08|Podem acreditar."

msgctxt "0x2f6b702e"
msgid "22.12|24.02|Okay, let's set up a perimeter ASAP."
msgstr "22.12|24.02|Certo, vamos montar um perímetro já."

msgctxt "0xe97b4388"
msgid "22.48|23.15|Hey Sarge!"
msgstr "22.48|23.15|Ei, Sargento!"

msgctxt "0x2f68702d"
msgid "23.15|25.32|I thought you said the French were gonna surrender."
msgstr "23.15|25.32|Achei que você disse que os franceses iam se render."

msgctxt "0x2f6b7029"
msgid "24.02|27.15|I don't want to lose this airfield to |another counter-attack."
msgstr "24.02|27.15|Não quero perder este aeródromo |pra outro contra-ataque."

msgctxt "0x2f68702c"
msgid "25.49|26.72|Yeah, storming the beach was fun and all,"
msgstr "25.49|26.72|É, invadir a praia foi divertido e tal,"

msgctxt "0x2f68702f"
msgid "26.72|28.69|but I gotta get back. I got tickets to the Yankees game."
msgstr "26.72|28.69|mas eu preciso voltar. Tenho ingresso pro jogo dos Yankees."

msgctxt "0x2f6b7028"
msgid "27.55|28.82|Now get goin'."
msgstr "27.55|28.82|Agora andem."

msgctxt "0x2f68702e"
msgid "28.69|29.59|They're playing the Red Sox,"
msgstr "28.69|29.59|Eles vão jogar contra os Red Sox,"

msgctxt "0x2f687029"
msgid "29.59|31.09|I got box seats!"
msgstr "29.59|31.09|e eu tenho camarote!"

msgctxt "0xf4dd5698"
msgid "3 o'clock!"
msgstr "Às 3 horas!"

msgctxt "0x54b5c598"
msgid "3 o'clock!"
msgstr "Às 3 horas!"

msgctxt "0x2f687028"
msgid "31.09|32.36|Shut the hell up, Bloomfield!"
msgstr "31.09|32.36|Cala a boca, Bloomfield!"

msgctxt "0x2f68702b"
msgid "32.36|34.00|I said can it!"
msgstr "32.36|34.00|Eu disse chega!"

msgctxt "0x2f68702a"
msgid "34.46|38.20|Resistance or not, |we got an airfield to secure, private."
msgstr "34.46|38.20|Com resistência ou não, |temos um aeródromo pra tomar, soldado."

msgctxt "0x2f687025"
msgid "38.83|41.94|Tell you what fellas, I'm glad those Frenchies"
msgstr "38.83|41.94|Vou dizer uma coisa, pessoal, que bom que esses franceses"

msgctxt "0x2f687024"
msgid "42.84|44.64|decided to fight back."
msgstr "42.84|44.64|resolveram revidar."

msgctxt "0x2f68704d"
msgid "45.01|48.34|And for Christ's sake, Kelly, watch where you|point that rifle."
msgstr "45.01|48.34|E pelo amor de Deus, Kelly, cuidado pra onde|aponta esse fuzil."

msgctxt "0x2f68704c"
msgid "48.44|49.98|Try and remember that."
msgstr "48.44|49.98|Tenta lembrar disso."

msgctxt "0x13d59479"
msgid "4|I wonder what they're hiding behind that door?|Hey, cover me, will ya?"
msgstr "4|Será que estão escondendo alguma coisa atrás dessa porta?|Ei, me cobre, tá?"

msgctxt "0x2f68704f"
msgid "50.01|52.88|It'll keep you from blowing the head off the guy next to you."
msgstr "50.01|52.88|Assim você não estoura a cabeça do cara do seu lado."

msgctxt "0x2f68704e"
msgid "52.88|53.72|Okay, Sarge."
msgstr "52.88|53.72|Certo, Sargento."

msgctxt "0x2f687049"
msgid "53.72|55.72|Look at all this sand, guys."
msgstr "53.72|55.72|Olha quanta areia, pessoal."

msgctxt "0x2f687048"
msgid "55.72|57.95|I sure ain't in Jersey no more."
msgstr "55.72|57.95|Com certeza não estou mais em Jersey."

msgctxt "0x2f68704b"
msgid "57.95|60.52|Well, at least you can be thankful for that..."
msgstr "57.95|60.52|Bom, pelo menos isso você tem a agradecer..."

msgctxt "0x9a6465c4"
msgid "5|Almost open... almost... open... almost..."
msgstr "5|Quase abrindo... quase... abriu... quase..."

msgctxt "0x266106ae"
msgid "5|Private, move up the line and shut that tower down!|We can't lose another damn halftrack!"
msgstr "5|Soldado, avance na linha e cale aquela torre!|Não podemos perder mais um maldito half-track!"

msgctxt "0xadda6939"
msgid "5|See those hangars? Get in there and secure them.|I don't care how you do it. Make 'em ours."
msgstr "5|Estão vendo aqueles hangares? Entrem lá e tomem eles.|Não me importa como. Façam deles nossos."

msgctxt "0xf3d8172b"
msgid "5|They got a 20mm covering the route into the airfield.|We're getting torn to shreds out there."
msgstr "5|Eles têm um canhão de 20 mm cobrindo a entrada do aeródromo.|Estão fazendo picadinho da gente lá fora."

msgctxt "0x84dd5699"
msgid "6 o'clock!"
msgstr "Às 6 horas!"

msgctxt "0x64b5c599"
msgid "6 o'clock!"
msgstr "Às 6 horas!"

msgctxt "0x2f68704a"
msgid "61.52|63.39|Oh god! Medic!"
msgstr "61.52|63.39|Meu Deus! Médico!"

msgctxt "0x2f687045"
msgid "64.43|66.73|Private, get on that gun!"
msgstr "64.43|66.73|Soldado, pega aquela arma!"

msgctxt "0x7d377af4"
msgid "6|Our planes are comin' in!  Sarge wants us to keep|those Frenchies off that AA gun!"
msgstr "6|Nossos aviões estão chegando! O Sargento quer que a gente|mantenha esses franceses longe do canhão antiaéreo!"

msgctxt "0xb37a8e5f"
msgid "6|Soldier, take Kelly and Bloomfield and mop up|that barracks on the right. I want it squeaky clean!"
msgstr "6|Soldado, leve Kelly e Bloomfield e limpe|aquele quartel à direita. Quero tudo um brinco!"

msgctxt "0xf7684194"
msgid "6|We need to open the doors to the last hangar so our halftracks can|get into the airfield! Flank the gun and take it out. Go!"
msgstr "6|Precisamos abrir as portas do último hangar pros nossos half-tracks|entrarem no aeródromo! Flanqueie o canhão e destrua. Vai!"

msgctxt "0xebaa8929"
msgid "8|Alright, men, we gotta secure those barracks.|Don't move on until you're sure the area's clean."
msgstr "8|Muito bem, pessoal, temos que tomar aqueles quartéis.|Não avancem até ter certeza de que a área está limpa."

msgctxt "0x24dd569a"
msgid "9 o'clock!"
msgstr "Às 9 horas!"

msgctxt "0x84b5c59a"
msgid "9 o'clock!"
msgstr "Às 9 horas!"

msgctxt "0x3b57ff94"
msgid "All right, we're moving. Stay with the convoy!"
msgstr "Certo, estamos indo. Fiquem com o comboio!"

msgctxt "0x9722025c"
msgid "Allied aircraft met overwhelming resistance"
msgstr "Aeronaves aliadas enfrentaram resistência esmagadora"

msgctxt "0xbf931184"
msgid "And take out any aircraft you see!"
msgstr "E derrube qualquer avião que aparecer!"

msgctxt "0xb6470dee"
msgid "Baptism by Fire"
msgstr "Batismo de Fogo"

msgctxt "0xe452ffb4"
msgid "Bombers!"
msgstr "Bombardeiros!"

msgctxt "0x61ac6de9"
msgid "Brooklyn! You idiot! You're gonna get us all killed!"
msgstr "Brooklyn! Seu idiota! Você vai matar todo mundo!"

msgctxt "0xd65e29b1"
msgid "Brooklyn, you're a moron."
msgstr "Brooklyn, você é um imbecil."

msgctxt "0x62111095"
msgid "Can do, Sarge!"
msgstr "Deixa comigo, Sargento!"

msgctxt "0xe099d2a5"
msgid "Clear out the buildings"
msgstr "Limpe os prédios"

msgctxt "0xe099d2a7"
msgid "Clear out the control tower"
msgstr "Limpe a torre de controle"

msgctxt "0x674a9052"
msgid "Clear out the hangars (0/4)"
msgstr "Limpe os hangares (0/4)"

msgctxt "0x674a9053"
msgid "Clear out the hangars (1/4)"
msgstr "Limpe os hangares (1/4)"

msgctxt "0x674a9050"
msgid "Clear out the hangars (2/4)"
