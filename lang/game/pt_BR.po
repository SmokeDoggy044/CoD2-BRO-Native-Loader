msgstr "Elimine os inimigos nos canhões antiaéreos e perto deles (faltam 7)"

msgctxt "0x70bda9b6"
msgid "Eliminate the enemies on and near the flak guns (8 remaining)"
msgstr "Elimine os inimigos nos canhões antiaéreos e perto deles (faltam 8)"

msgctxt "0x70bda9b7"
msgid "Eliminate the enemies on and near the flak guns (9 remaining)"
msgstr "Elimine os inimigos nos canhões antiaéreos e perto deles (faltam 9)"

msgctxt "0x927eb1dd"
msgid "Everyone down, now!"
msgstr "Todo mundo abaixado, já!"

msgctxt "0x1ef72ae0"
msgid "Fighters!"
msgstr "Caças!"

msgctxt "0xfc6422f2"
msgid "Get in there!"
msgstr "Entra lá!"

msgctxt "0x5667ae3e"
msgid "Get out of there!"
msgstr "Sai daí!"

msgctxt "0x39e6b35e"
msgid "Get over there and see if you can flank the tower|though those buildings."
msgstr "Vai lá e vê se consegue flanquear a torre|por aqueles prédios."

msgctxt "0x8616e928"
msgid "Good shot!"
msgstr "Belo tiro!"

msgctxt "0xfe8cdfc6"
msgid "Grenade!"
msgstr "Granada!"

msgctxt "0x2878e9a8"
msgid "Haha! Just like breakin' into my father's liquor cabinet!"
msgstr "Haha! Igualzinho a arrombar o armário de bebidas do meu pai!"

msgctxt "0xb0a6bb91"
msgid "Hang back and wait for the convoy to clear the gates."
msgstr "Fica pra trás e espera o comboio passar pelos portões."

msgctxt "0xbfc3c998"
msgid "Hawk and Vic are flanking 'em, come on..."
msgstr "Hawk e Vic estão flanqueando eles, vamos..."

msgctxt "0x33d422fd"
msgid "Here comes more of 'em!"
msgstr "Lá vêm mais deles!"

msgctxt "0x290acff7"
msgid "Hey Vic!"
msgstr "Ei, Vic!"

msgctxt "0x4d9011dc"
msgid "Hey cowboy!"
msgstr "Ei, caubói!"

msgctxt "0x28212c7c"
msgid "Hold up!"
msgstr "Espera!"

msgctxt "0x9c73e441"
msgid "Hope that wasn't one of ours!"
msgstr "Tomara que não fosse um dos nossos!"

msgctxt "0x65b42ec5"
msgid "I got him! Hey, guys, you see that?"
msgstr "Peguei ele! Ei, pessoal, viram isso?"

msgctxt "0xac203d35"
msgid "I need help over here!"
msgstr "Preciso de ajuda aqui!"

msgctxt "0x35155ab9"
msgid "I said cover me! I can't work like this!"
msgstr "Eu disse pra me cobrir! Não dá pra trabalhar assim!"

msgctxt "0xbb992c49"
msgid "I say we go down there and give 'em a taste of their own medicine."
msgstr "Eu digo pra gente descer lá e dar a eles um gostinho do próprio veneno."

msgctxt "0x35c9ad77"
msgid "I think that's the last of 'em. You did it!"
msgstr "Acho que esses foram os últimos. Você conseguiu!"

msgctxt "0xe3fba497"
msgid "I'm from the Bronx, Sarge."
msgstr "Eu sou do Bronx, Sargento."

msgctxt "0xd8f73bb2"
msgid "Jackpot!"
msgstr "Na mosca!"

msgctxt "0xfe913913"
msgid "Just a few more!"
msgstr "Só mais alguns!"

msgctxt "0xa7e7309b"
msgid "Keep close, boys!"
msgstr "Fiquem perto, rapazes!"

msgctxt "0x135d8e6a"
msgid "Keep it up!"
msgstr "Continua assim!"

msgctxt "0xff59f9e6"
msgid "Keep moving!"
msgstr "Continuem andando!"

msgctxt "0xa7dae1fe"
msgid "Keep moving! Don't stop!"
msgstr "Continuem andando! Não parem!"

msgctxt "0x3f17db1e"
msgid "Knock, knock. It's the Fighting First coming to kick your asses!"
msgstr "Toc, toc. É a Fighting First chegando pra chutar o traseiro de vocês!"

msgctxt "0xc05ba26a"
msgid "Left tower! Look out!"
msgstr "Torre da esquerda! Cuidado!"

msgctxt "0xba7a03af"
msgid "Look out! On the right!"
msgstr "Cuidado! À direita!"

msgctxt "0xba29abaf"
msgid "Look out, on the left!"
msgstr "Cuidado, à esquerda!"

msgctxt "0x98f06b77"
msgid "Nice hit!"
msgstr "Belo acerto!"

msgctxt "0x1fa7a691"
msgid "Nice shooting!"
msgstr "Boa pontaria!"

msgctxt "0x03f47e91"
msgid "Nice shooting, keep on it!"
msgstr "Boa pontaria, continua assim!"

msgctxt "0x1b34fd15"
msgid "Nice shot!"
msgstr "Belo tiro!"

msgctxt "0xd3f4421e"
msgid "Nice shot, private!"
msgstr "Belo tiro, soldado!"

msgctxt "0x61156a75"
msgid "North!"
msgstr "Norte!"

msgctxt "0xa13d7051"
msgid "North!"
msgstr "Norte!"

msgctxt "0x7db2dc7b"
msgid "November 8th, 1942"
msgstr "8 de novembro de 1942"

msgctxt "0x6ba1a61c"
msgid "Now we have to take out that machine gun."
msgstr "Agora temos que destruir aquela metralhadora."

msgctxt "0x62627477"
msgid "Oh, that don't sound so good."
msgstr "Ih, isso não parece nada bom."

msgctxt "0x7f7b07ea"
msgid "On the left!"
msgstr "À esquerda!"

msgctxt "0xb71d5bca"
msgid "Oran, North Africa"
msgstr "Oran, Norte da África"

msgctxt "0x22ea7a0c"
msgid "Our boys still don't have a place to land!"
msgstr "Nossos rapazes ainda não têm onde pousar!"

msgctxt "0x49366d9f"
msgid "Outstanding."
msgstr "Excelente."

msgctxt "0x77c16d86"
msgid "Press [STANCE_DOWN] to crouch in the turret for cover."
msgstr "Pressione [STANCE_DOWN] para se abaixar na torre e se proteger."

msgctxt "0x72bd3008"
msgid "Press [STANCE_UP] to stand back up in the turret."
msgstr "Pressione [STANCE_UP] para se levantar de novo na torre."

msgctxt "0xab23e882"
msgid "Press [USE] to exit the flakvierling."
msgstr "Pressione [USE] para sair do Flakvierling."

msgctxt "0x686fc588"
msgid "Press [USE] to get out of the vehicle."
msgstr "Pressione [USE] para sair do veículo."

msgctxt "0x2a6327f4"
msgid "Private Kelly, shoot back!"
msgstr "Soldado Kelly, revida!"

msgctxt "0x3e6157ec"
msgid "Private! Get over here!"
msgstr "Soldado! Vem cá!"

msgctxt "0xc1f19575"
msgid "Private, I'll go up over the rafters. Push on!"
msgstr "Soldado, eu vou por cima das vigas. Avança!"

msgctxt "0x9bf3087f"
msgid "Private, get on that gun!"
msgstr "Soldado, pega aquela arma!"

msgctxt "0x3e607fff"
msgid "Private, we gotta get across that street and into that garage."
msgstr "Soldado, temos que atravessar aquela rua e entrar naquela garagem."

msgctxt "0xe099d2a4"
msgid "Protect the convoy"
msgstr "Proteja o comboio"

msgctxt "0x6d3690b0"
msgid "Regroup with your squad or you will fail the mission"
msgstr "Reagrupe com seu esquadrão ou você falhará na missão"

msgctxt "0xbfb94167"
msgid "Sarge, is now a bad time to request a furlough?"
msgstr "Sargento, agora é uma hora ruim pra pedir uma licença?"

msgctxt "0xcea1012b"
msgid "Shut up and keep firing!"
msgstr "Cala a boca e continua atirando!"

msgctxt "0xe84663cf"
msgid "Sounds like we got one!"
msgstr "Parece que derrubamos um!"

msgctxt "0xa0e16c51"
msgid "South!"
msgstr "Sul!"

msgctxt "0x60b97675"
msgid "South!"
msgstr "Sul!"

msgctxt "0x8b563a15"
msgid "Stars on your compass indicate attacking Stukas"
msgstr "Estrelas na bússola indicam Stukas atacando"

msgctxt "0xa45867fc"
msgid "Stay down, watch out!"
msgstr "Fica abaixado, cuidado!"

msgctxt "0xc1d37393"
msgid "Stay together. We're almost to the airfield!"
msgstr "Fiquem juntos. Estamos quase no aeródromo!"

msgctxt "0xc7bb8f93"
msgid "Stay with the vehicles!"
msgstr "Fiquem com os veículos!"

msgctxt "0x9eff007f"
msgid "Stop both AA guns from shooting to allow a plane to land"
msgstr "Faça os dois canhões antiaéreos pararem de atirar para um avião poder pousar"

msgctxt "0x1f9eb37f"
msgid "Stukas!"
msgstr "Stukas!"

msgctxt "0xe9518a5c"
msgid "Survive the final enemy strafing run"
msgstr "Sobreviva ao último ataque rasante inimigo"

msgctxt "0xe4059d20"
msgid "Take Brooklyn with you."
msgstr "Leva o Brooklyn com você."

msgctxt "0xf6120f93"
msgid "Thanks, but ya know, we really had it handled..."
msgstr "Valeu, mas sabe, a gente tinha tudo sob controle..."

msgctxt "0x5bb2c214"
msgid "That's one of our planes comin' in from Gibraltar."
msgstr "Aquele é um dos nossos aviões vindo de Gibraltar."

msgctxt "0x7bc8360f"
msgid "The convoy rolls in first, then we follow."
msgstr "O comboio entra primeiro, depois a gente segue."

msgctxt "0x2bd96108"
msgid "They gotta guy on the gun! Take 'em out!"
msgstr "Tem um cara naquela arma! Derruba ele!"

msgctxt "0x307af841"
msgid "They just knocked down one of our boys!"
msgstr "Acabaram de derrubar um dos nossos!"

msgctxt "0x404372d6"
msgid "They'll be low on fuel and will need to land."
msgstr "Eles vão estar com pouco combustível e vão precisar pousar."

msgctxt "0xb5d640c2"
msgid "This don't look too good."
msgstr "Isso não está com cara boa."

msgctxt "0x75397fe5"
msgid "Use that sniper rifle!"
msgstr "Usa esse fuzil de precisão!"

msgctxt "0x674a8c5b"
msgid "Use the flakvierling to shoot down the stukas (1 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (falta 1)"

msgctxt "0x674a8c52"
msgid "Use the flakvierling to shoot down the stukas (10 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 10)"

msgctxt "0x674a8c5a"
msgid "Use the flakvierling to shoot down the stukas (2 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 2)"

msgctxt "0x674a8c55"
msgid "Use the flakvierling to shoot down the stukas (3 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 3)"

msgctxt "0x674a8c54"
msgid "Use the flakvierling to shoot down the stukas (4 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 4)"

msgctxt "0x674a8c57"
msgid "Use the flakvierling to shoot down the stukas (5 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 5)"

msgctxt "0x674a8c56"
msgid "Use the flakvierling to shoot down the stukas (6 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 6)"

msgctxt "0x674a8c51"
msgid "Use the flakvierling to shoot down the stukas (7 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 7)"

msgctxt "0x674a8c50"
msgid "Use the flakvierling to shoot down the stukas (8 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 8)"

msgctxt "0x674a8c53"
msgid "Use the flakvierling to shoot down the stukas (9 remaining)"
msgstr "Use o Flakvierling para derrubar os Stukas (faltam 9)"

msgctxt "0xb9dbfc77"
msgid "Use those rocks for cover! Move, move!"
msgstr "Usem essas pedras de cobertura! Vai, vai!"

msgctxt "0x4e008fd4"
msgid "Use those vehicles for cover."
msgstr "Usem esses veículos de cobertura."

msgctxt "0xf7004e64"
msgid "Wait for me!"
msgstr "Me espera!"

msgctxt "0x95b46ad0"
msgid "Wait till the fighters make their next pass, then make a run for it."
msgstr "Espera os caças fazerem a próxima passada e aí corre."

msgctxt "0x3b43ec79"
msgid "Wait up!"
msgstr "Espera aí!"

msgctxt "0xf469b434"
msgid "We can't stay here! Keep pushing forward!"
msgstr "Não dá pra ficar aqui! Continuem avançando!"

msgctxt "0x9d16c23b"
msgid "We got company!"
msgstr "Temos companhia!"

msgctxt "0x27a86537"
msgid "We gotta get in there and take out that machinegun!"
msgstr "Temos que entrar lá e destruir aquela metralhadora!"

msgctxt "0x00e3ed02"
msgid "We gotta hit that tower!"
msgstr "Temos que acertar aquela torre!"

msgctxt "0x5462f2a1"
msgid "We gotta stop that gun and take out that control tower."
msgstr "Temos que parar aquele canhão e tomar a torre de controle."

msgctxt "0xedcf7fd3"
msgid "We gotta take that airfield."
msgstr "Temos que tomar aquele aeródromo."

msgctxt "0x88306c11"
msgid "We gotta take this airfield so our boys can land!"
msgstr "Temos que tomar este aeródromo pros nossos poderem pousar!"

msgctxt "0xb978c443"
msgid "We'll be slaughtered if we try to take those guys head on."
msgstr "Vão massacrar a gente se a gente atacar eles de frente."

msgctxt "0xf7c58241"
msgid "We're in! Move up, Fox! Push through!"
msgstr "Entramos! Avança, Fox! Força!"

msgctxt "0x88346426"
msgid "We're pinned down!"
msgstr "Estamos encurralados!"

msgctxt "0x09d4eca4"
msgid "We're too late!"
msgstr "Chegamos tarde!"

msgctxt "0x856d65d5"
msgid "Well, professor, I'll be more than happy to take your cut."
msgstr "Bom, professor, vou ficar feliz em pegar a sua parte."

msgctxt "0xcd04e3a1"
msgid "West!"
msgstr "Oeste!"

msgctxt "0xeb07a370"
msgid "West!"
msgstr "Oeste!"

msgctxt "0xc0724180"
msgid "What the hell is he doing?!"
msgstr "Que diabos ele está fazendo?!"

msgctxt "0x63c98a09"
msgid "You can't get a good shot from here. Move in through that building!  "
msgstr "Daqui não dá pra acertar. Entra por aquele prédio!  "

msgctxt "0xda42cd70"
msgid "You failed to regroup with your squad"
msgstr "Você não se reagrupou com seu esquadrão"

msgctxt "0x23bb86bc"
msgid "You got that one!"
msgstr "Pegou esse!"

msgctxt "0x7a0cfe34"
msgid "You're going AWOL! Return to your squad!"
msgstr "Você está desertando! Volte para o seu esquadrão!"

# ---- kasserine.en.stb ----
msgctxt "0x4f103424"
msgid "'Bout time!"
msgstr "Até que enfim!"

msgctxt "0x7e87c666"
msgid "01.10|02.00|  "
msgstr "01.10|02.00|  "

msgctxt "0x7e87c665"
msgid "02.20|03.00|   "
msgstr "02.20|03.00|   "

msgctxt "0x7e87e266"
msgid "02.46|04.43|I gotta report this mess to Delaney."
msgstr "02.46|04.43|Tenho que relatar essa bagunça pro Delaney."

msgctxt "0x7e87c664"
msgid "04.00|05.57|What the hell's going on?"
msgstr "04.00|05.57|Que diabos está acontecendo?"

msgctxt "0x7e87c663"
msgid "05.57|07.10|Looks like they're pulling back."
msgstr "05.57|07.10|Parece que eles estão recuando."

msgctxt "0x7e87c662"
msgid "07.10|08.60|I guess they didn't know we was comin'."
msgstr "07.10|08.60|Acho que não sabiam que a gente vinha."

msgctxt "0x7e87e265"
msgid "07.60|09.30|You gonna be okay, Sarge?"
msgstr "07.60|09.30|Você vai ficar bem, Sargento?"

msgctxt "0x7e87c661"
msgid "08.60|10.51|Shut up for once Brooklyn, would ya?"
msgstr "08.60|10.51|Cala a boca pelo menos uma vez, Brooklyn, tá?"

msgctxt "0x7e87e264"
msgid "09.30|11.24|This one wasn't even close."
msgstr "09.30|11.24|Essa nem chegou perto."

msgctxt "0x7e87c660"
msgid "10.51|12.17|Alright, gather 'round, boys."
msgstr "10.51|12.17|Certo, cheguem aqui, rapazes."

msgctxt "0x7e87e263"
msgid "11.24|14.11|I'd try to get some time off for that."
msgstr "11.24|14.11|Eu tentaria conseguir uma folga por isso."

msgctxt "0x7e87c66f"
msgid "12.17|16.85|Just got word from Battalion. The Germans are mounting|a full-scale counterattack to retake this village."
msgstr "12.17|16.85|Acabei de receber notícia do Batalhão. Os alemães estão preparando|um contra-ataque em grande escala pra retomar esta vila."

msgctxt "0x822ad019"
msgid "1350 Hours"
msgstr "13h50"

msgctxt "0x7e87e262"
msgid "14.11|15.81|Maybe go home. Wouldn't you?"
msgstr "14.11|15.81|Talvez ir pra casa. Você não iria?"

msgctxt "0x7e87e261"
msgid "15.81|21.22|Nah. Gettin' shot at here is still better than sellin' shoes|for my girlfriend's dad back home."
msgstr "15.81|21.22|Que nada. Levar tiro aqui ainda é melhor que vender sapato|pro pai da minha namorada lá em casa."

msgctxt "0x7e87c66e"
msgid "16.85|18.28|Well, we ain't gonna let that happen."
msgstr "16.85|18.28|Bom, a gente não vai deixar isso acontecer."

msgctxt "0xd0f8ccff"
msgid "18.28|24.75|Slow down, cowboy. This village is only a field hospital.|Look around, our medics aren't armed."
msgstr "18.28|24.75|Calma aí, caubói. Esta vila é só um hospital de campanha.|Olha em volta, nossos médicos não estão armados."

msgctxt "0x7e87e260"
msgid "21.92|26.22|Seriously, you could see some pretty scary stuff when ya|take off people's shoes all day..."
msgstr "21.92|26.22|Sério, dá pra ver umas coisas bem assustadoras quando você|tira o sapato dos outros o dia todo..."

msgctxt "0xd0f8ccfe"
msgid "24.75|25.79|What are you sayin'?"
msgstr "24.75|25.79|O que você está dizendo?"

msgctxt "0xd0f8ccfd"
msgid "25.79|30.79|I'm saying we gotta defend this position long enough|to get our docs safely out of here."
msgstr "25.79|30.79|Estou dizendo que temos que defender esta posição o suficiente|pra tirar nossos médicos daqui em segurança."

msgctxt "0xd0f8ccfc"
msgid "30.79|34.56|The Forward O.P. puts the Germans|to the Southeast and closing fast."
msgstr "30.79|34.56|O posto de observação avançado coloca os alemães|a sudeste, chegando rápido."

msgctxt "0xd0f8ccfb"
msgid "34.56|39.50|They'll be moving up the road towards our position|with at least one full infantry division, probably more."
msgstr "34.56|39.50|Eles vão subir a estrada rumo à nossa posição|com pelo menos uma divisão de infantaria inteira, talvez mais."

msgctxt "0xd0f8ccfa"
msgid "39.50|41.64|Ha, gotta love those odds."
msgstr "39.50|41.64|Ha, adoro essas chances."

msgctxt "0xd0f8ccf9"
msgid "41.64|43.31|Private, you, Kelly and Brooklyn, take a couple other men..."
msgstr "41.64|43.31|Soldado, você, Kelly e Brooklyn, peguem mais uns homens..."

msgctxt "0xd0f8ccf8"
msgid "43.31|45.34|Uh, Sarge, actually I'm from the..."
msgstr "43.31|45.34|Hã, Sargento, na verdade eu sou do..."

msgctxt "0xd0f8ccf7"
msgid "45.34|49.21|Take a couple other men and set up |defensive positions at the main intersection."
msgstr "45.34|49.21|Peguem mais uns homens e montem |posições defensivas no cruzamento principal."

msgctxt "0xd0f8ccf6"
msgid "49.21|54.75|You'll a have good field of fire on from there.|Keep those Krauts out of this town, understand?"
msgstr "49.21|54.75|Vocês vão ter um bom campo de tiro de lá.|Mantenham esses chucrutes fora desta cidade, entenderam?"

msgctxt "0x5f9f809f"
msgid "4|Make sure you grab what ammo you can from|the trucks before you head out. Now get goin'."
msgstr "4|Peguem toda a munição que puderem dos|caminhões antes de sair. Agora andem."

msgctxt "0x6b663309"
msgid "4|What are you waiting for?! Grab those field|dressings and get 'em over here! Now!"
msgstr "4|Está esperando o quê?! Pega essas ataduras|e traz aqui! Agora!"

msgctxt "0x93aeb910"
msgid "5|Hawkins is under heavy fire from the southwest. Get over|there and rejoin the rest of your company ASAP!"
msgstr "5|Hawkins está sob fogo pesado vindo do sudoeste. Vai pra lá|e se junta ao resto da sua companhia o quanto antes!"

msgctxt "0xb98524c2"
msgid "5|I think we gave 'em enough time. Now it's our turn,|let's hustle back to camp and bug outta here."
msgstr "5|Acho que já demos tempo suficiente. Agora é a nossa vez,|vamos voltar rápido pro acampamento e cair fora daqui."

msgctxt "0x9c51e1c3"
msgid "5|Okay, you go back and grab that medic we saw.|Keep your head down and get back here quick!"
msgstr "5|Certo, volta lá e traz aquele médico que a gente viu.|Mantém a cabeça baixa e volta rápido!"

msgctxt "0x6036f5ea"
msgid "6|We could really use that .30. Vic, you're with me.|The rest of you, cover from here."
msgstr "6|Aquela .30 viria a calhar. Vic, você vem comigo.|O resto de vocês, dá cobertura daqui."

msgctxt "0xb0668b70"
msgid "Advance toward nebelwerfers"
msgstr "Avance até os Nebelwerfers"

msgctxt "0xa1219533"
msgid "Advance toward nebelwerfers"
msgstr "Avance até os Nebelwerfers"

msgctxt "0xb0668b71"
msgid "Advance toward nebelwerfers"
msgstr "Avance até os Nebelwerfers"

msgctxt "0x23cc7a5a"
msgid "Alright, take me to him."
msgstr "Certo, me leva até ele."

msgctxt "0xcfd6973a"
msgid "Apply field dressings on Sgt. Hawkins"
msgstr "Aplique ataduras no Sgt. Hawkins"

msgctxt "0xb066eb75"
msgid "Apply medkit on Hawkins"
msgstr "Use o kit médico em Hawkins"

msgctxt "0x69d816ff"
msgid "Aw crap."
msgstr "Ah, droga."

msgctxt "0xc0d8fab7"
msgid "Charge planted!"
msgstr "Carga plantada!"

msgctxt "0xc0d8f593"
msgid "Charges set!"
msgstr "Cargas prontas!"

msgctxt "0x57f063e1"
msgid "Clear!"
msgstr "Limpo!"

msgctxt "0x36add1ac"
msgid "Come on!  What are you waiting for?"
msgstr "Vamos! Tá esperando o quê?"

msgctxt "0x23add7c3"
msgid "Come on! We're almost there!"
msgstr "Vamos! Estamos quase lá!"

msgctxt "0xa626c431"
msgid "Come on, come on!"
msgstr "Vamos, vamos!"

msgctxt "0x4442e5b1"
msgid "Counterattack"
msgstr "Contra-ataque"

msgctxt "0xa1219530"
msgid "Cover Hawkins as he advances into position"
msgstr "Dê cobertura a Hawkins enquanto ele avança para a posição"

msgctxt "0x778c09c7"
msgid "Dammit... Screamin' Mimi's!"
msgstr "Droga... Screamin' Mimis!"

msgctxt "0xa1219535"
msgid "Defend the SE intersection"
msgstr "Defenda o cruzamento SE"

msgctxt "0xb0664b70"
msgid "Defend the SE intersection"
msgstr "Defenda o cruzamento SE"

msgctxt "0xb0668b73"
msgid "Destroy nebelwerfers (0/2)"
msgstr "Destrua os Nebelwerfers (0/2)"

msgctxt "0xb0668b72"
msgid "Destroy nebelwerfers (1/2)"
msgstr "Destrua os Nebelwerfers (1/2)"

msgctxt "0xb0668b75"
msgid "Destroy nebelwerfers (2/2)"
msgstr "Destrua os Nebelwerfers (2/2)"

msgctxt "0xe8d6535f"
msgid "Fall back! Fall back!"
msgstr "Recuar! Recuar!"

msgctxt "0x79576243"
msgid "Fall back, now!"
msgstr "Recuem, já!"

msgctxt "0x8222f339"
msgid "February 22nd, 1943"
msgstr "22 de fevereiro de 1943"

msgctxt "0x52e79e5e"
msgid "Get 'em!"
msgstr "Pega eles!"

msgctxt "0x3694cbb4"
msgid "Get a charge on that launcher!"
msgstr "Põe uma carga naquele lançador!"

msgctxt "0xa6f0569d"
msgid "Get back into the house and take cover."
msgstr "Volta pra casa e se protege."

msgctxt "0xfe737f65"
msgid "Get back! Watch out!"
msgstr "Pra trás! Cuidado!"

msgctxt "0xd230f53b"
msgid "Get down, are you crazy?!"
msgstr "Abaixa, tá maluco?!"

msgctxt "0x5aa78a77"
msgid "Get in! C'mon!"
msgstr "Entra! Vamos!"

msgctxt "0x55803a4e"
msgid "Get into the halftrack!"
msgstr "Entre no half-track!"

msgctxt "0x818ad862"
msgid "Get into the jeep!"
msgstr "Entre no jipe!"

msgctxt "0x818ad8a2"
msgid "Get into the truck!"
msgstr "Entre no caminhão!"

msgctxt "0x8e655886"
msgid "Get on 'em!"
msgstr "Em cima deles!"

msgctxt "0xa1219534"
msgid "Get to the SE intersection"
msgstr "Vá até o cruzamento SE"

msgctxt "0xb0662b70"
msgid "Get to the SW intersection"
msgstr "Vá até o cruzamento SO"

msgctxt "0xb0662b71"
msgid "Get to the passage to the SW intersection"
msgstr "Vá até a passagem para o cruzamento SO"

msgctxt "0xa1219536"
msgid "Get to the passage to the SW intersection"
msgstr "Vá até a passagem para o cruzamento SO"

msgctxt "0x270b4ca3"
msgid "Get up on the roof, you'll get a better angle from up there."
msgstr "Sobe no telhado, lá de cima você tem um ângulo melhor."

msgctxt "0x9dae766a"
msgid "Get upstairs!"
msgstr "Sobe a escada!"

msgctxt "0xb918c104"
msgid "Go upstairs to use the .30 cal"
msgstr "Suba para usar a .30"

msgctxt "0x8a03cdaa"
msgid "Guess this is it."
msgstr "Acho que é isso."

msgctxt "0x8e64b283"
msgid "Hawk's been hit!"
msgstr "O Hawk foi atingido!"

msgctxt "0xb066eb71"
msgid "Head back to medic's position"
msgstr "Volte até a posição do médico"

msgctxt "0x37e4badf"
msgid "Hey, we're looking for the main intersection. This it?"
msgstr "Ei, estamos procurando o cruzamento principal. É este?"

msgctxt "0xa1219531"
msgid "Hold back the German counterattack"
msgstr "Contenha o contra-ataque alemão"

msgctxt "0x6970c682"
msgid "Hustle!"
msgstr "Rápido!"

msgctxt "0xbc840369"
msgid "I could do without 'em, Sarge."
msgstr "Eu passaria sem eles, Sargento."

msgctxt "0x795b2e00"
msgid "I hope our docs got out okay."
msgstr "Espero que nossos médicos tenham saído bem."

msgctxt "0xaa1313a1"
msgid "I see 'im! He's up that tower!"
msgstr "Tô vendo ele! Está naquela torre!"

msgctxt "0x4518b395"
msgid "Kasserine, North Africa"
msgstr "Kasserine, Norte da África"

msgctxt "0xf23d4e16"
msgid "Keep moving!"
msgstr "Continuem andando!"

msgctxt "0xef5bbdda"
msgid "Keep on 'em!"
msgstr "Em cima deles!"

msgctxt "0x581042ed"
msgid "Keep running!"
msgstr "Continua correndo!"

msgctxt "0xb066eb73"
msgid "Kill the sniper"
msgstr "Mate o atirador de elite"

msgctxt "0x81f08a25"
msgid "Krauts moving in on the--"
msgstr "Chucrutes avançando no..."

msgctxt "0x197450d8"
msgid "Krauts, dead ahead!"
msgstr "Chucrutes bem na frente!"

msgctxt "0x369542f6"
msgid "Let's keep moving!"
msgstr "Vamos continuar andando!"

msgctxt "0x9897913f"
msgid "Look, there they are!"
msgstr "Olha, lá estão eles!"

msgctxt "0x7231db3a"
msgid "Man down! Medic!"
msgstr "Homem ferido! Médico!"

msgctxt "0xa121953c"
msgid "Mop up Germans below"
msgstr "Acabe com os alemães lá embaixo"

msgctxt "0xbbe467ff"
msgid "More Krauts!"
msgstr "Mais chucrutes!"

msgctxt "0x1b4f4179"
msgid "Move up! Stay low."
msgstr "Avancem! Fiquem abaixados."

msgctxt "0xb63dfce3"
msgid "Move, move, move!"
msgstr "Vai, vai, vai!"

msgctxt "0x20bd53ee"
msgid "Move, now! Run! Run!"
msgstr "Anda, já! Corre! Corre!"

msgctxt "0xbb915a53"
msgid "Oh, God..."
msgstr "Ai, meu Deus..."

msgctxt "0xb69df336"
msgid "Okay, get over there! We'll give ya cover."
msgstr "Certo, vai lá! A gente te dá cobertura."

msgctxt "0x982047e3"
msgid "Outstanding! Let's get the next one."
msgstr "Excelente! Vamos pro próximo."

msgctxt "0x63ecf6ac"
msgid "Panzers right on our tail!"
msgstr "Panzers bem na nossa cola!"

msgctxt "0x47cfeeda"
msgid "Panzers!"
msgstr "Panzers!"

msgctxt "0x01cf0332"
msgid "Pick up field dressings that medic dropped"
msgstr "Pegue as ataduras que o médico deixou cair"

msgctxt "0xb066eb72"
msgid "Pick up the medkit"
msgstr "Pegue o kit médico"

msgctxt "0x2ba16656"
msgid "Place some charges on those friggin' launchers!"
msgstr "Põe umas cargas nesses malditos lançadores!"

msgctxt "0x3dbe7a2d"
msgid "Planted!"
msgstr "Plantada!"

msgctxt "0x3b09a27d"
msgid "Press [USE] to apply field dressings"
msgstr "Pressione [USE] para aplicar as ataduras"

msgctxt "0x2250c328"
msgid "Press [USE] to board the halftrack"
msgstr "Pressione [USE] para embarcar no half-track"

msgctxt "0xfa49a9e6"
msgid "Press [USE] to pick up the medic's bag"
msgstr "Pressione [USE] para pegar a bolsa do médico"

msgctxt "0x3b914ac2"
msgid "Press [USE] to plant explosive charges"
msgstr "Pressione [USE] para plantar cargas explosivas"

msgctxt "0x13ee4d09"
msgid "Press [USE] to talk to the medic"
msgstr "Pressione [USE] para falar com o médico"

msgctxt "0x50cc35cc"
msgid "Push through! We got no other choice! "
msgstr "Força! Não temos outra escolha! "

msgctxt "0xa121953d"
msgid "Retreat and return to the camp"
msgstr "Recue e volte ao acampamento"

msgctxt "0xa1219532"
msgid "Return to camp to resupply"
msgstr "Volte ao acampamento para se reabastecer"

msgctxt "0x37ce9eff"
msgid "Run!"
msgstr "Corre!"

msgctxt "0xa2dcce97"
msgid "Sarge is down! Medic!"
msgstr "O Sargento caiu! Médico!"

msgctxt "0xa1219537"
msgid "Secure first house"
msgstr "Tome a primeira casa"

msgctxt "0xb0660b71"
msgid "Secure second house"
msgstr "Tome a segunda casa"

msgctxt "0xac2bdaa8"
msgid "Sniper!"
msgstr "Atirador de elite!"

msgctxt "0x29b60d63"
msgid "Somebody get on that thirty!"
msgstr "Alguém pega aquela .30!"

msgctxt "0x838494fb"
msgid "Take Denley and assault the right flank."
msgstr "Leva o Denley e ataca o flanco direito."

msgctxt "0xb066cb71"
msgid "Take cover in the house"
msgstr "Proteja-se na casa"

msgctxt "0xb066eb70"
msgid "Take medic back to Hawkins"
msgstr "Leve o médico até Hawkins"

msgctxt "0xd6c5f394"
msgid "Take that! Ya Kraut bastard!"
msgstr "Toma essa! Chucrute desgraçado!"

msgctxt "0xd7e73262"
msgid "That house is lousy with 'em, let's get in there and clear it out."
msgstr "Aquela casa está cheia deles, vamos entrar lá e limpar."

msgctxt "0x192c4958"
msgid "Thatta way! Up the road!"
msgstr "Por ali! Subindo a estrada!"

msgctxt "0x6bd251f0"
msgid "There they are!"
msgstr "Lá estão eles!"

msgctxt "0xfb01d9fc"
msgid "There they are."
msgstr "Lá estão eles."

msgctxt "0x73ffb662"
msgid "There's the Sarge!"
msgstr "Lá está o Sargento!"

msgctxt "0x5c919342"
msgid "They're holed up on that ridge, and they don't have much protection."
msgstr "Eles estão entrincheirados naquele morro e não têm muita proteção."

msgctxt "0x09131008"
msgid "They're moving in from the south."
msgstr "Eles estão vindo do sul."

msgctxt "0x9c9d831d"
msgid "They're pinned down!"
msgstr "Eles estão encurralados!"

msgctxt "0x191d8a29"
msgid "They're right on top of us!"
msgstr "Eles estão em cima da gente!"

msgctxt "0x15a22516"
msgid "This way!"
msgstr "Por aqui!"

msgctxt "0x35bb3c16"
msgid "This way!"
msgstr "Por aqui!"

msgctxt "0xf2852b47"
msgid "Those damn rocket launchers have officially|become our problem now."
msgstr "Esses malditos lança-foguetes agora|viraram oficialmente problema nosso."

msgctxt "0x278df486"
msgid "Up and over!"
msgstr "Sobe e passa!"

msgctxt "0xb0664b71"
msgid "Use the 30 cal on the roof"
msgstr "Use a .30 no telhado"

msgctxt "0xc98e7b6f"
msgid "Warning: You are leaving the combat area, turn back."
msgstr "Atenção: você está saindo da área de combate, volte."

msgctxt "0x3c3d1792"
msgid "Watch out for the 42s!"
msgstr "Cuidado com as 42!"

msgctxt "0x798e3bc8"
msgid "We can't stay here."
msgstr "Não dá pra ficar aqui."

msgctxt "0xa45faad6"
msgid "We did it! This crappy mud pit is ours!"
msgstr "Conseguimos! Esse buraco de lama nojento é nosso!"

msgctxt "0x9413561e"
msgid "We got 'em on the run now!"
msgstr "Agora eles estão fugindo!"

msgctxt "0x14f265c7"
msgid "We got company!"
msgstr "Temos companhia!"

msgctxt "0x042136c3"
msgid "We got nowhere to run!"
msgstr "Não temos pra onde correr!"

msgctxt "0x09d6f609"
msgid "We gotta knock out those Screaming Mimis!"
msgstr "Temos que destruir esses Screaming Mimis!"

msgctxt "0x05865630"
msgid "We gotta move!"
msgstr "Temos que nos mexer!"

msgctxt "0x9956eedf"
msgid "We gotta shut those damn rockets down!"
msgstr "Temos que calar esses malditos foguetes!"

msgctxt "0x809dded8"
msgid "We have to keep moving!"
msgstr "Temos que continuar andando!"

msgctxt "0xb68d3d9c"
msgid "We need suppressing fire now!"
msgstr "Precisamos de fogo de supressão agora!"

msgctxt "0xe234126b"
msgid "We'll go around!"
msgstr "A gente dá a volta!"

msgctxt "0x3a834d14"
msgid "We're almost clear!"
msgstr "Estamos quase livres!"

msgctxt "0xab9de7aa"
msgid "We're cut off!"
msgstr "Fomos cercados!"

msgctxt "0x34173ac5"
msgid "We're dead meat out here!"
msgstr "Aqui fora a gente é carne morta!"

msgctxt "0x2faeaa8b"
msgid "We're in trouble! We gotta get outta here!"
msgstr "Estamos encrencados! Temos que sair daqui!"

msgctxt "0x9e93e242"
msgid "We're sendin' him over, hold on!"
msgstr "Estamos mandando ele, aguenta aí!"

msgctxt "0x61be4a6d"
msgid "What do we do..."
msgstr "O que a gente faz..."

msgctxt "0x40c6065f"
msgid "What the heck was that?"
msgstr "Que diabos foi isso?"

msgctxt "0x7dd41383"
msgid "Where is he? Did anyone see?"
msgstr "Cadê ele? Alguém viu?"

msgctxt "0xe37ec6e9"
msgid "Where's that damn medic?!"
msgstr "Cadê a droga do médico?!"

msgctxt "0x3a104bf9"
msgid "Yeeeeehaaaah!"
msgstr "Iiiiiirrááá!"

msgctxt "0xf5b8be5a"
msgid "You have left the combat area, mission failed"
msgstr "Você saiu da área de combate, missão fracassada"

msgctxt "0x2111701e"
msgid "You nailed that sumbitch."
msgstr "Você acertou aquele filho da mãe."

msgctxt "0x7dd148ce"
msgid "You're a better shot than me, take 'im out."
msgstr "Você atira melhor que eu, derruba ele."

msgctxt "0xa3c9d754"
msgid "You've abandoned your squad"
msgstr "Você abandonou seu esquadrão"

msgctxt "0x8f245bb6"
msgid "You've been cut off from your squad"
msgstr "Você foi separado do seu esquadrão"

# ---- kasserine_pass.en.stb ----
msgctxt "0x7480f688"
msgid "'Bout time!"
msgstr "Até que enfim!"

msgctxt "0x9602c16c"
msgid "00.50|02.23|I knew I could count on you two."
msgstr "00.50|02.23|Eu sabia que podia contar com vocês dois."

msgctxt "0x9602f96c"
msgid "01.00|03.77|Good to see you guys in once piece."
msgstr "01.00|03.77|Bom ver vocês inteiros."

msgctxt "0x9602d16c"
msgid "02.00|05.33|There's a minefield around the bend that's|keeping us from advancing."
msgstr "02.00|05.33|Tem um campo minado depois da curva que está|impedindo nosso avanço."

msgctxt "0x9602c16f"
msgid "02.23|03.50|I had it covered."
msgstr "02.23|03.50|Eu estava com tudo sob controle."

msgctxt "0x9602c16e"
msgid "03.53|07.40|The Germans have captured our artillery positions|on the other side of the pass."
msgstr "03.53|07.40|Os alemães tomaram nossas posições de artilharia|do outro lado do desfiladeiro."

msgctxt "0x9602f96f"
msgid "03.77|06.00|That was some real nice soldiering there."
msgstr "03.77|06.00|Isso sim foi coisa de soldado de verdade."

msgctxt "0x9602d16f"
msgid "05.33|07.70|Why don't you send the engineers in to clear it out?"
msgstr "05.33|07.70|Por que não mandam os engenheiros limpar o campo?"

msgctxt "0x9602f96e"
msgid "06.00|07.07|Thanks, Sarge."
msgstr "06.00|07.07|Valeu, Sargento."

msgctxt "0x9602c56c"
msgid "06.20|09.54|Sniper! Get down behind these rocks!"
msgstr "06.20|09.54|Atirador! Abaixem atrás dessas pedras!"

msgctxt "0x9602c169"
msgid "07.40|10.51|We have to recapture them before our tanks can move through."
msgstr "07.40|10.51|Temos que retomar as posições antes que nossos tanques possam passar."

msgctxt "0x9602d16e"
msgid "07.70|11.64|That's where you guys come in.|Area's too hot for them without an escort."
msgstr "07.70|11.64|É aí que vocês entram.|A área está quente demais pra eles sem escolta."

msgctxt "0x9602f969"
msgid "07.90|12.04|Looks like you boys got the Desert Fox retreating|with his tail between his legs."
msgstr "07.90|12.04|Parece que vocês fizeram a Raposa do Deserto recuar|com o rabo entre as pernas."

msgctxt "0x928920d4"
msgid "0910 hours"
msgstr "09h10"

msgctxt "0xf0f47208"
msgid "10|As I was saying, Rommel's Panzers rolled over the 26th.|Regiment's sending us up to take it back for keeps."
msgstr "10|Como eu dizia, os Panzers do Rommel passaram por cima do 26º.|O Regimento está mandando a gente retomar de vez."

msgctxt "0x9602c56f"
msgid "11.04|13.74|I think I know where he is. Stay put."
msgstr "11.04|13.74|Acho que sei onde ele está. Fiquem aí."

msgctxt "0x9602d169"
msgid "11.64|17.98|Sgt. Hassler and his boys are waiting by a footpath to the minefield.|Place is lousy with Germans, Sergeant."
msgstr "11.64|17.98|O Sgt. Hassler e os rapazes dele esperam numa trilha até o campo minado.|O lugar está cheio de alemães, Sargento."

msgctxt "0x9602f968"
msgid "12.14|15.24|Time to head back to camp and get a hot meal."
msgstr "12.14|15.24|Hora de voltar pro acampamento e comer algo quente."

msgctxt "0x9602c168"
msgid "14.08|17.98|Forward scouts have discovered an abandoned|village in the hills above the pass."
msgstr "14.08|17.98|Os batedores avançados descobriram uma vila|abandonada nos morros acima do desfiladeiro."

msgctxt "0x9602c56e"
msgid "15.44|17.45|I think I got him--"
msgstr "15.44|17.45|Acho que peguei ele..."

msgctxt "0x9602c569"
msgid "17.45|20.22|We have to do something about that sniper."
msgstr "17.45|20.22|Temos que dar um jeito naquele atirador."

msgctxt "0x9602d168"
msgid "17.98|19.55|We're getting used to that, mac."
msgstr "17.98|19.55|A gente já está se acostumando, amigo."

msgctxt "0x9602c16b"
msgid "17.98|21.12|The route through it should take you|directly to our captured artillery."
msgstr "17.98|21.12|O caminho por ela deve levar vocês|direto à nossa artilharia capturada."

msgctxt "0x9602d16b"
msgid "19.55|20.82|Appreciate the help."
msgstr "19.55|20.82|Agradeço a ajuda."

msgctxt "0x9602c568"
msgid "20.22|24.09|Grab that Springfield.|You're a better shot with that thing than I am."
msgstr "20.22|24.09|Pega aquele Springfield.|Você atira melhor com ele do que eu."

msgctxt "0x9602d16a"
msgid "20.82|30.99|Okay, you heard him. I want you guys to escort those engineers.|Just provide support. Don't do anything stupid, I need you alive."
msgstr "20.82|30.99|Certo, vocês ouviram. Quero vocês escoltando aqueles engenheiros.|Só deem apoio. Nada de besteira, preciso de vocês vivos."

msgctxt "0x9602c16a"
msgid "21.12|23.09|Kelly! Go with 'em."
msgstr "21.12|23.09|Kelly! Vai com eles."

msgctxt "0xa2ffef66"
msgid "4|There's a fifty on that jeep. Give us some suppressing|fire and buy us some time."
msgstr "4|Tem uma .50 naquele jipe. Dá fogo de supressão|pra gente e ganha um tempo."

msgctxt "0x9d97d7b7"
msgid "4|When we stop, grab some mines from the back, we'll leave|a little surprise for Rommel."
msgstr "4|Quando a gente parar, pega umas minas lá atrás, vamos deixar|uma surpresinha pro Rommel."

msgctxt "0xca571777"
msgid "4|You guys sure mean business. Let's go.|The minefield's just down there, in the pass."
msgstr "4|Vocês não estão de brincadeira mesmo. Vamos.|O campo minado é logo ali embaixo, no desfiladeiro."

msgctxt "0x59f84562"
msgid "5|Not much. We managed to scrape up a couple of|halftracks with the 75's, like back in Oran."
msgstr "5|Não muito. Conseguimos arranjar uns|half-tracks com os 75, que nem em Oran."

msgctxt "0xcd5025ae"
msgid "5|That's the last of 'em... at least for now. You and Denley, on me!"
msgstr "5|Esses foram os últimos... pelo menos por enquanto. Você e o Denley, comigo!"

msgctxt "0x1e8b6ba4"
msgid "5|The 26th got their asses handed to them by Rommel|and his damn Afrika Korps."
msgstr "5|O 26º levou uma surra do Rommel|e do maldito Afrika Korps dele."

msgctxt "0xa5f670bc"
msgid "5|Those Kraut bazookas sure tore up our Shermans.|I wonder how well they work against their own tanks."
msgstr "5|Aquelas bazucas dos chucrutes acabaram com nossos Shermans.|Quero ver como elas se saem contra os tanques deles."

msgctxt "0xb46f55bc"
msgid "And we're coming to get it back, right Sarge?"
msgstr "E a gente vai lá pegar de volta, né, Sargento?"

msgctxt "0x7596f4ce"
msgid "Another MG42! "
msgstr "Outra MG42! "

msgctxt "0x389fc00f"
msgid "Are you deaf? Get on that anti-tank gun, Private!"
msgstr "Tá surdo? Pega aquele canhão antitanque, soldado!"

msgctxt "0x5557a8a0"
msgid "Come with me."
msgstr "Vem comigo."

msgctxt "0x368ae3dc"
msgid "Dammit! Keep 'em off us!"
msgstr "Droga! Segurem eles longe da gente!"

msgctxt "0x6087f142"
msgid "Dammit! We're too late! Hang on!"
msgstr "Droga! Chegamos tarde! Aguenta aí!"

msgctxt "0xc80be546"
msgid "Damn it, O'Bryant. Thanks for the heads up before you detonated."
msgstr "Valeu, O'Bryant. Obrigado por avisar antes de detonar."

msgctxt "0xee73d736"
msgid "Disable the SDKfz222 Antiaircraft Gun"
msgstr "Desative o canhão antiaéreo SdKfz 222"

msgctxt "0x93fcb1f8"
msgid "Don't let up!"
msgstr "Não deem trégua!"

msgctxt "0xcba38d53"
msgid "Escort Engineers to the minefield"
msgstr "Escolte os engenheiros até o campo minado"

msgctxt "0x928103f4"
msgid "February 19th, 1943"
msgstr "19 de fevereiro de 1943"

msgctxt "0x2c7918c1"
msgid "Find a foxhole!  We've gotta hold 'em off till|our tankers get here!"
msgstr "Achem uma trincheira! Temos que segurar eles até|nossos tanques chegarem!"

msgctxt "0x470d0ea0"
msgid "Follow me."
msgstr "Me siga."

msgctxt "0x9e45ffe8"
msgid "Get in Pvt. Denley's foxhole - Defend the left flank"
msgstr "Entre na trincheira do Sd. Denley - Defenda o flanco esquerdo"

msgctxt "0xc12ef532"
msgid "Get off the damn road!"
msgstr "Saiam da droga da estrada!"

msgctxt "0xba892571"
msgid "Get on that .50 cal!"
msgstr "Pega aquela .50!"

msgctxt "0x60c785b9"
msgid "Get your asses to cover! Move it! Move!"
msgstr "Corram pra cobertura! Andem! Andem!"

msgctxt "0x78072303"
msgid "Give it to 'em!"
msgstr "Manda bala neles!"

msgctxt "0xcbcdfe0c"
msgid "Grab that Springfield. You're a better shot with that than I am."
msgstr "Pega aquele Springfield. Você atira melhor com ele do que eu."

msgctxt "0x17578f68"
msgid "Hell yeah, Vic. I got enough Comp B to blow us a hole|all the way to China."
msgstr "Pode crer, Vic. Tenho Comp B suficiente pra abrir um buraco|até a China."

msgctxt "0x213b6d1e"
msgid "Here come the Stuarts!"
msgstr "Lá vêm os Stuarts!"

msgctxt "0x36ce3794"
msgid "Here they come! We did it!"
msgstr "Lá vêm eles! Conseguimos!"

msgctxt "0x6f1ff50d"
msgid "Hold 'em back! I'm losing men here!"
msgstr "Segurem eles! Estou perdendo homens aqui!"

msgctxt "0xf17116e5"
msgid "Hold [USE]  to pick up the Panzerschreck"
msgstr "Segure [USE]  para pegar o Panzerschreck"

msgctxt "0x6d85ea9e"
msgid "Hold [USE] to pick up the Springfield"
msgstr "Segure [USE] para pegar o Springfield"

msgctxt "0xc3f7c293"
msgid "Hold [USE] to plant the charges"
msgstr "Segure [USE] para plantar as cargas"

msgctxt "0x55361369"
msgid "Hold your positions! Don't fall back!"
msgstr "Mantenham as posições! Ninguém recua!"

msgctxt "0x2e5b25c0"
msgid "I need you on that .50 cal, Private! Go!"
msgstr "Preciso de você naquela .50, soldado! Vai!"

msgctxt "0x8c7867ec"
msgid "I think I got him."
msgstr "Acho que peguei ele."

msgctxt "0x8c786fd7"
msgid "I think I know where he is. Stay put."
msgstr "Acho que sei onde ele está. Fiquem aí."

msgctxt "0x2cff00e0"
msgid "If those tanks get through we're screwed!"
msgstr "Se esses tanques passarem, estamos ferrados!"

msgctxt "0xa1f5633c"
msgid "It looks like we're moving the whole division up.|What's goin' on Sarge?"
msgstr "Parece que estão movendo a divisão inteira.|O que está acontecendo, Sargento?"

msgctxt "0x187c230c"
msgid "Jesus, Sarge. That ain't makin' me feel any better."
msgstr "Nossa, Sargento. Isso não está me deixando nada mais tranquilo."

msgctxt "0x5c8e75a3"
msgid "Just clear the way, thank you."
msgstr "É só abrir o caminho, obrigado."

msgctxt "0x3355be87"
msgid "Keep firing!"
msgstr "Continuem atirando!"

msgctxt "0x439d591b"
msgid "Kraut machinegun!"
msgstr "Metralhadora dos chucrutes!"

msgctxt "0xb7b46558"
msgid "Let's hope that .50 still has something in it."
msgstr "Tomara que essa .50 ainda tenha alguma coisa."

msgctxt "0xb759de25"
msgid "Let's take out that quad .50!"
msgstr "Vamos destruir aquela .50 quádrupla!"

msgctxt "0x8805c939"
msgid "Look. It's Hawk and Kelly."
msgstr "Olha. É o Hawk e o Kelly."

msgctxt "0xf41461d6"
msgid "Lookout! He's coming right for us!"
msgstr "Cuidado! Ele está vindo direto pra cima da gente!"

msgctxt "0xb988ddba"
msgid "Looks like that quad fifty is givin' our planes hell too!  Lets go!"
msgstr "Parece que aquela .50 quádrupla está infernizando nossos aviões também! Vamos!"

msgctxt "0x2fd659b7"
msgid "Man that gun now! No tanks get through! Understand?"
msgstr "Assuma aquele canhão agora! Nenhum tanque passa! Entendeu?"

msgctxt "0x7a60c032"
msgid "Man the 50 cal. machinegun - Defend the right flank"
msgstr "Assuma a metralhadora .50 - Defenda o flanco direito"

msgctxt "0x0edbeee7"
msgid "Mighty obliged."
msgstr "Muito agradecido."

msgctxt "0x07db0924"
msgid "More Panzers!"
msgstr "Mais Panzers!"

msgctxt "0x5166aa37"
msgid "Near Kasserine, North Africa"
msgstr "Perto de Kasserine, Norte da África"

msgctxt "0x594b81fc"
msgid "Nice shootin'... maybe you should've joined the artillery."
msgstr "Bela pontaria... devia ter entrado pra artilharia."

msgctxt "0xc34172f0"
msgid "Nice shot!"
msgstr "Belo tiro!"

msgctxt "0x19a65117"
msgid "O'Bryant, you still got any satchel charges with you?"
msgstr "O'Bryant, ainda tem alguma carga de demolição aí?"

msgctxt "0x016ec9a6"
msgid "One more to go."
msgstr "Falta mais um."

msgctxt "0xf46661b0"
msgid "Panzers? Our Stuarts don't stand a chance! We got anything bigger?"
msgstr "Panzers? Nossos Stuarts não têm chance! Temos alguma coisa maior?"

msgctxt "0xa4a951d3"
msgid "Press [USE] to mount 75mm Halftrack"
msgstr "Pressione [USE] para assumir o half-track de 75 mm"

msgctxt "0xf4a22fb7"
msgid "Recapture the Allied artillery pieces (0 of 3 remaining)"
msgstr "Retome as peças de artilharia aliadas (faltam 0 de 3)"

msgctxt "0xf6a22fb7"
msgid "Recapture the Allied artillery pieces (1 of 3 remaining)"
msgstr "Retome as peças de artilharia aliadas (falta 1 de 3)"

msgctxt "0xf0a22fb7"
msgid "Recapture the Allied artillery pieces (2 of 3 remaining)"
msgstr "Retome as peças de artilharia aliadas (faltam 2 de 3)"

msgctxt "0xf2a22fb7"
msgid "Recapture the Allied artillery pieces (3 of 3 remaining)"
msgstr "Retome as peças de artilharia aliadas (faltam 3 de 3)"

msgctxt "0xc76edc4e"
msgid "Regroup with Sgt. Hawkins"
msgstr "Reagrupe com o Sgt. Hawkins"

msgctxt "0x4bcbf269"
msgid "Regroup with your squad."
msgstr "Reagrupe com seu esquadrão."

msgctxt "0x16a2d08a"
msgid "Rendezvous with the engineers"
msgstr "Encontre os engenheiros"

msgctxt "0xf73248fe"
msgid "Rendezvous with the squad"
msgstr "Encontre o esquadrão"

msgctxt "0xe03d4aa0"
msgid "Sarge! We ain't gonna do squat against that Tiger!"
msgstr "Sargento! A gente não vai fazer nada contra aquele Tiger!"

msgctxt "0xb40a88d7"
msgid "Sarge, they're right on top of us!"
msgstr "Sargento, eles estão em cima da gente!"

msgctxt "0x4f4d6e06"
msgid "Shut the hell up and keep shooting!"
msgstr "Cala a boca e continua atirando!"

msgctxt "0xdbec1e92"
msgid "Sniper! Get down!"
msgstr "Atirador! Abaixa!"

msgctxt "0x5b4b19e9"
msgid "Something like that, Vic."
msgstr "Mais ou menos isso, Vic."

msgctxt "0x503cfc13"
msgid "The Desert Fox"
msgstr "A Raposa do Deserto"

msgctxt "0xd50b7967"
msgid "There they are. They're using our own guns against us!"
msgstr "Lá estão eles. Estão usando nossos próprios canhões contra a gente!"

msgctxt "0xf42cb7fc"
msgid "There's a sniper..."
msgstr "Tem um atirador..."

msgctxt "0xecffcfdf"
msgid "There's another! Take 'em out!"
msgstr "Tem outro! Derruba ele!"

msgctxt "0xd5789807"
msgid "There's our armor!"
msgstr "Lá estão nossos blindados!"

msgctxt "0x2394369b"
msgid "They better get here soon or we're through! Just keep firing!"
msgstr "É bom eles chegarem logo ou estamos acabados! Continuem atirando!"

msgctxt "0x5bcfce6c"
msgid "They're flanking on the left! Get on that fifty! Now!"
msgstr "Estão flanqueando pela esquerda! Pega aquela .50! Já!"

msgctxt "0x176e2663"
msgid "Tiger! Get in a foxhole!"
msgstr "Tiger! Entrem numa trincheira!"

msgctxt "0xb8665a09"
msgid "Tiger! What the hell are we gonna do now?"
msgstr "Tiger! Que diabos a gente faz agora?"

msgctxt "0x65e380d9"
msgid "Use the 50 cal. to defend the engineers"
msgstr "Use a .50 para defender os engenheiros"

msgctxt "0x87cbea3d"
msgid "Use the 75mm gun to destroy the Panzers (0 of 5 remaining)"
msgstr "Use o canhão de 75 mm para destruir os Panzers (faltam 0 de 5)"

msgctxt "0x85cbea3d"
msgid "Use the 75mm gun to destroy the Panzers (1 of 5 remaining)"
msgstr "Use o canhão de 75 mm para destruir os Panzers (falta 1 de 5)"

msgctxt "0x83cbea3d"
msgid "Use the 75mm gun to destroy the Panzers (2 of 5 remaining)"
msgstr "Use o canhão de 75 mm para destruir os Panzers (faltam 2 de 5)"

msgctxt "0x81cbea3d"
msgid "Use the 75mm gun to destroy the Panzers (3 of 5 remaining)"
msgstr "Use o canhão de 75 mm para destruir os Panzers (faltam 3 de 5)"

msgctxt "0x8fcbea3d"
msgid "Use the 75mm gun to destroy the Panzers (4 of 5 remaining)"
msgstr "Use o canhão de 75 mm para destruir os Panzers (faltam 4 de 5)"

msgctxt "0x8dcbea3d"
msgid "Use the 75mm gun to destroy the Panzers (5 of 5 remaining)"
msgstr "Use o canhão de 75 mm para destruir os Panzers (faltam 5 de 5)"

msgctxt "0x822ae122"
msgid "Use the Panzerschrek to destroy the Panzers  (0 of 3 remaining)"
msgstr "Use o Panzerschreck para destruir os Panzers  (faltam 0 de 3)"

msgctxt "0x802ae122"
msgid "Use the Panzerschrek to destroy the Panzers  (1 of 3 remaining)"
msgstr "Use o Panzerschreck para destruir os Panzers  (falta 1 de 3)"

msgctxt "0x862ae122"
msgid "Use the Panzerschrek to destroy the Panzers  (2 of 3 remaining)"
msgstr "Use o Panzerschreck para destruir os Panzers  (faltam 2 de 3)"

msgctxt "0x842ae122"
msgid "Use the Panzerschrek to destroy the Panzers  (3 of 3 remaining)"
msgstr "Use o Panzerschreck para destruir os Panzers  (faltam 3 de 3)"

msgctxt "0x71da05ee"
msgid "Use the Panzerschrek to destroy the SdKfz 222"
msgstr "Use o Panzerschreck para destruir o SdKfz 222"

msgctxt "0x1cd93fce"
msgid "Use the Springfield to clear the snipers (0 of 3 remaining)"
msgstr "Use o Springfield para eliminar os atiradores (faltam 0 de 3)"

msgctxt "0x1ed93fce"
msgid "Use the Springfield to clear the snipers (1 of 3 remaining)"
msgstr "Use o Springfield para eliminar os atiradores (falta 1 de 3)"

msgctxt "0x18d93fce"
msgid "Use the Springfield to clear the snipers (2 of 3 remaining)"
msgstr "Use o Springfield para eliminar os atiradores (faltam 2 de 3)"

msgctxt "0x1ad93fce"
msgid "Use the Springfield to clear the snipers (3 of 3 remaining)"
msgstr "Use o Springfield para eliminar os atiradores (faltam 3 de 3)"

msgctxt "0xc20dd30f"
msgid "We gotta take out that Kraut armored car!"
msgstr "Temos que destruir aquele carro blindado dos chucrutes!"

msgctxt "0x8c8e9b17"
msgid "We gotta take that path, up there on the switchback."
msgstr "Temos que pegar aquela trilha, lá em cima no zigue-zague."

msgctxt "0x41951fa3"
msgid "We have to do something about that sniper."
msgstr "Temos que dar um jeito naquele atirador."

msgctxt "0x1556bd84"
msgid "We need to take out them fifties so our flyboys can make their run!"
msgstr "Temos que destruir essas .50 pros nossos pilotos fazerem a passada!"

msgctxt "0xec79d602"
msgid "We've got 'em on the run!"
msgstr "Eles estão fugindo!"

msgctxt "0x1f5e9fb9"
msgid "Well Vic, we've got to do something, and fast. "
msgstr "Bom, Vic, temos que fazer alguma coisa, e rápido. "

msgctxt "0x0f9e86db"
msgid "Well we can't do anything with that armor down there."
msgstr "Bom, com aqueles blindados lá embaixo a gente não pode fazer nada."

msgctxt "0x691552fe"
msgid "Well? Get to it, would ya? We ain't got all day."
msgstr "E aí? Mãos à obra, tá? Não temos o dia todo."

msgctxt "0xf80b3b5d"
msgid "Where the hell's our armor?"
msgstr "Cadê os nossos blindados?"

msgctxt "0xc51cf765"
msgid "Whoowee. That was about as close as it gets."
msgstr "Uau. Essa foi por um triz."

msgctxt "0x15ce7f7c"
msgid "Yeeeehaaaah!"
msgstr "Iiiiirrááá!"

msgctxt "0x71453a16"
msgid "You are exposed to sniper fire, return to cover."
msgstr "Você está exposto ao fogo do atirador, volte para a cobertura."

msgctxt "0x0a7a81ef"
msgid "You failed to regroup with your squad."
msgstr "Você não se reagrupou com seu esquadrão."

msgctxt "0xf5a8f7c2"
msgid "You gonna stand there all day? Let's go!"
msgstr "Vai ficar parado aí o dia todo? Vamos!"

msgctxt "0xd257638a"
msgid "You guys from Fox? Glad you could make it... let's get this done."
msgstr "Vocês são da Fox? Que bom que vieram... vamos acabar com isso."

msgctxt "0xfe3d1c4b"
msgid "You men get down there and--"
msgstr "Vocês, desçam lá e..."

msgctxt "0xec8d5822"
msgid "You're telling me, Vic. Good work out there.|Let's find what's goin' on."
msgstr "Nem me fala, Vic. Bom trabalho lá fora.|Vamos ver o que está acontecendo."

# ---- tunisia.en.stb ----
msgctxt "0xf4cc8ed9"
msgid "1100 Hours"
msgstr "11h00"

msgctxt "0xf016a9b7"
msgid "4|All we have to do is clear the defenses and our flyboys|will take care of the rest."
msgstr "4|Só temos que limpar as defesas e nossos pilotos|cuidam do resto."

msgctxt "0x6d004e5a"
msgid "4|If we can clear those emplacements our boys|will have a clear shot on that second gun."
msgstr "4|Se limparmos essas posições, nossos rapazes|vão ter tiro livre naquele segundo canhão."

msgctxt "0xd1a2cbe6"
msgid "5|Black six this is blue two. Set at phase-line Kentucky.|Request air support, over."
msgstr "5|Black Six, aqui é Blue Two. Na linha de fase Kentucky.|Solicito apoio aéreo, câmbio."

msgctxt "0x5e61f0e9"
msgid "5|Blue two this is black six. Air support is en route.|Sit back and enjoy the show, gentlemen. Over."
msgstr "5|Blue Two, aqui é Black Six. Apoio aéreo a caminho.|Relaxem e aproveitem o show, senhores. Câmbio."

msgctxt "0xcf053afe"
msgid "6|Private, you better have a good reason why you're sitting in|that tank and not in a halftrack with the rest of your squad."
msgstr "6|Soldado, é bom você ter um bom motivo pra estar sentado|nesse tanque e não num half-track com o resto do seu esquadrão."

msgctxt "0x9f7d75bf"
msgid "6|This is the U.S. Army, not a goddamn carnival, son.|See that my rifleman is back in his halftrack next stop."
msgstr "6|Isto é o Exército dos EUA, não um maldito parque de diversões, filho.|Garanta que meu fuzileiro volte pro half-track na próxima parada."

msgctxt "0x120115ee"
msgid "6|Well, it looks like you won't be getting back in that halftrack|anytime soon so you might as well make yourself useful."
msgstr "6|Bom, parece que você não vai voltar pra aquele half-track|tão cedo, então é melhor se fazer útil."

msgctxt "0xebf921a0"
msgid "7|It's my fault, sir. He wanted a ride and my brother wouldn't|be alive if it weren't for what you guys did at that airfield."
msgstr "7|A culpa é minha, senhor. Ele queria uma carona, e meu irmão não|estaria vivo se não fosse o que vocês fizeram naquele aeródromo."

msgctxt "0x759f2e9a"
msgid "88!"
msgstr "88!"

msgctxt "0x759f2d82"
msgid "88!"
msgstr "88!"

msgctxt "0xb8e211cb"
msgid "All right First Infantry!"
msgstr "Isso aí, Primeira Infantaria!"

msgctxt "0x9361835d"
msgid "Armor!"
msgstr "Blindados!"

msgctxt "0x93dd835d"
msgid "Armor!"
msgstr "Blindados!"

msgctxt "0xce57e2f7"
msgid "Continue along the road"
msgstr "Siga pela estrada"

msgctxt "0xcafc5ea9"
msgid "Destroy attacking M13/40s"
msgstr "Destrua os M13/40 atacantes"

msgctxt "0xcafc5eab"
msgid "Destroy enemy waystation"
msgstr "Destrua o posto de apoio inimigo"

msgctxt "0xce57e2fd"
msgid "Destroy enemy weapon emplacements"
msgstr "Destrua as posições de armas inimigas"

msgctxt "0xce57e2f4"
msgid "Destroy the Italian M13/40s"
msgstr "Destrua os M13/40 italianos"

msgctxt "0xce57e2f6"
msgid "Destroy the Panzerschreck teams"
msgstr "Destrua as equipes de Panzerschreck"

msgctxt "0xcafc5eaa"
msgid "Destroy the depot's defenses"
msgstr "Destrua as defesas do depósito"

msgctxt "0xce57e2f1"
msgid "Eliminate the M13/40s"
msgstr "Elimine os M13/40"

msgctxt "0xf4c4adf9"
msgid "February 13th, 1943"
msgstr "13 de fevereiro de 1943"

msgctxt "0xce57e2fc"
msgid "Flank dug-in Panzer IVs"
msgstr "Flanqueie os Panzer IV entrincheirados"

msgctxt "0x93876782"
msgid "Got 'im!"
msgstr "Peguei ele!"

msgctxt "0xbbd8a0c1"
msgid "Here we are!"
msgstr "Chegamos!"

msgctxt "0x31efb4de"
msgid "It's too quiet, I don't like this. Proceed carefully."
msgstr "Está quieto demais, não gosto disso. Avancem com cuidado."

msgctxt "0x11edc8f3"
msgid "Keep your eyes peeled for more infantry."
msgstr "Fiquem de olho em mais infantaria."

msgctxt "0x018871d4"
msgid "Kraut armor!"
msgstr "Blindados chucrutes!"

msgctxt "0x01887994"
msgid "Kraut armor!"
msgstr "Blindados chucrutes!"

msgctxt "0x0182b430"
msgid "Kraut tanks!"
msgstr "Tanques chucrutes!"

msgctxt "0x0182ac70"
msgid "Kraut tanks!"
msgstr "Tanques chucrutes!"

msgctxt "0xed4d86d6"
msgid "Let's get up there!"
msgstr "Vamos subir lá!"

msgctxt "0x163dfa2a"
msgid "Let's move out!"
msgstr "Vamos andando!"

msgctxt "0xf5ecf537"
msgid "Let's move out."
msgstr "Vamos andando."

msgctxt "0xd604f388"
msgid "Look at all those tanks!"
msgstr "Olha quantos tanques!"

msgctxt "0xf85dfa28"
msgid "Look at that place! There's no way we're getting in there."
msgstr "Olha aquele lugar! Não tem como a gente entrar lá."

msgctxt "0xfa4e7aae"
msgid "Look! Up there!"
msgstr "Olha! Lá em cima!"

msgctxt "0xfb80eeab"
msgid "Looks like we got 'em!"
msgstr "Parece que pegamos eles!"

msgctxt "0xe1880c64"
msgid "More tanks!"
msgstr "Mais tanques!"

msgctxt "0xe1880e24"
msgid "More tanks!"
msgstr "Mais tanques!"

msgctxt "0x40e80fe9"
msgid "Nice one!"
msgstr "Boa!"

msgctxt "0x1d0fe416"
msgid "Nice shot!"
msgstr "Belo tiro!"

msgctxt "0x7c98c1d3"
msgid "Nice!"
msgstr "Boa!"

msgctxt "0x62cdc204"
msgid "Okay, let's clear those defenses so the flyboys|can take care of the rest."
msgstr "Certo, vamos limpar essas defesas pros pilotos|cuidarem do resto."

