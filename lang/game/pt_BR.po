msgstr "Limpe os hangares (4/4)"

msgctxt "0x881ca48f"
msgid "Clear!"
msgstr "Limpo!"

msgctxt "0xe3c153d9"
msgid "Come on! Come on!"
msgstr "Vamos! Vamos!"

msgctxt "0x23c8665c"
msgid "Come on! What? You're not even curious what's in there?"
msgstr "Qual é! Você não tem nem curiosidade de saber o que tem lá?"

msgctxt "0x23ca6e5c"
msgid "Come on, what are you waiting for?"
msgstr "Vamos, tá esperando o quê?"

msgctxt "0x6ace91bc"
msgid "Continuously firing the .50 cal will cause it to overheat!"
msgstr "Disparar a .50 sem parar faz ela superaquecer!"

msgctxt "0x65a033e5"
msgid "Cover me!"
msgstr "Me cobre!"

msgctxt "0x674a8856"
msgid "Create a landing window for allied planes (0 remaining)"
msgstr "Abra uma janela de pouso para os aviões aliados (faltam 0)"

msgctxt "0x674a8851"
msgid "Create a landing window for allied planes (1 remaining)"
msgstr "Abra uma janela de pouso para os aviões aliados (falta 1)"

msgctxt "0x674a8850"
