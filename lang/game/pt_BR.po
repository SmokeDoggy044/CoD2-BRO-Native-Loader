msgstr "Abra uma janela de pouso para os aviões aliados (faltam 3)"

msgctxt "0x674a8852"
msgid "Create a landing window for allied planes (4 remaining)"
msgstr "Abra uma janela de pouso para os aviões aliados (faltam 4)"

msgctxt "0xec46107b"
msgid "Damn!"
msgstr "Droga!"

msgctxt "0x2f1b3dd1"
msgid "Debrief with Sgt. Hawkins"
msgstr "Apresente-se ao Sgt. Hawkins"

msgctxt "0xaab6b5c3"
msgid "Denley, on me."
msgstr "Denley, comigo."

msgctxt "0xeb67bfc2"
msgid "Disable both AA guns at once to create a landing window"
msgstr "Desative os dois canhões antiaéreos ao mesmo tempo para abrir uma janela de pouso"

msgctxt "0x0411aa74"
msgid "Don't stop! Drive right through!"
msgstr "Não para! Passa direto!"

msgctxt "0x0411aaa2"
msgid "Don't stop! Ram that gate!"
msgstr "Não para! Arrebenta esse portão!"

msgctxt "0xcd0c13a1"
msgid "East!"
msgstr "Leste!"

msgctxt "0xeb0ed370"
msgid "East!"
msgstr "Leste!"

msgctxt "0x9b9c2f68"
msgid "Eliminate the enemies on and near the flak guns"
msgstr "Elimine os inimigos nos canhões antiaéreos e perto deles"

