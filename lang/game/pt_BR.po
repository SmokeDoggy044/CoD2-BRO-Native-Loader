msgid "Panzers! Here they come!"
msgstr "Panzers! Lá vêm eles!"

msgctxt "0xa5bdd102"
msgid "Panzerschreck!"
msgstr "Panzerschreck!"

msgctxt "0xde91e688"
msgid "Panzerschrek!"
msgstr "Panzerschrek!"

msgctxt "0xde91fec8"
msgid "Panzerschrek!"
msgstr "Panzerschrek!"

